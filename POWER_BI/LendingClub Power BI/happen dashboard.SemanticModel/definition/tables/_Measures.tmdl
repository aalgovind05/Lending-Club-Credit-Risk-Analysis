table _Measures
	lineageTag: 7096aad0-e8da-45dd-a0a5-0910bbe272da

	measure 'Total Amount' = SUM(fact_loan[loan_amount])
		lineageTag: af8edc29-bc48-441c-a33d-18c6adcd24c2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Loan' = COUNTROWS(fact_loan)
		formatString: 0
		lineageTag: dc36ca83-d266-41df-be3e-793793bcd7b7

	measure 'AVG Interest Rate' = AVERAGE(fact_loan[interest_rate])
		lineageTag: 69e2cb4d-e771-46a7-8f4e-dc8c6ebb5f1f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'AVG DTI' = AVERAGE(fact_loan[win_dti])
		lineageTag: 78dc8122-8804-4946-be54-762e474d3676

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'AVG Annual Income' = AVERAGE(fact_loan[annual_income])
		lineageTag: dadc4e8a-bcc1-4e57-9bf1-1a2154ca7b80

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'AVG Default Rate' =
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(fact_loan),
			        dim_loan_status[loan_status] = "Charged Off"
			    ),
			    CALCULATE(
			        COUNTROWS(fact_loan),
			        ALL(dim_loan_status)
			    )
			)
		formatString: 0.0%
		lineageTag: 9179dbd8-734d-41db-a33d-dd3807defc3e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'AVG Fully Paid Rate' = ```
			
			    DIVIDE(
			        CALCULATE(
			            COUNTROWS(fact_loan),dim_loan_status[loan_status] = "Fully Paid"),
			            COUNTROWS(fact_loan))
			```
		formatString: 0.0%
		lineageTag: c8a3f05a-4200-48f5-8783-aacec88a10af

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Credit Age (Years)' =
			
			AVERAGEX(
			    fact_loan,
			    DATEDIFF(
			        fact_loan[earliest_credit_line],
			        fact_loan[issue_date],
			        YEAR
			    )
			)
		lineageTag: 51995886-9fd5-4f19-aca6-ef2852c3af01

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg FICO Score' =
			
			AVERAGEX(fact_loan,
			    (fact_loan[fico_range_low] + fact_loan[fico_range_high]) / 2
			)
		lineageTag: dbf34e54-402c-4ad1-a07d-f1de9ce2dafa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total loan amount for loans with status Fully paid.
	measure 'Total Amount - Fully Paid' = CALCULATE([Total Amount], 'dim_loan_status'[loan_status] = "Fully paid")
		lineageTag: 59204dba-f4a8-4cfa-8f8a-1ab560090b77

	/// HTML block for the 4 top KPI cards (Total Loan Amount, Avg Interest Rate, Default Rate, Avg FICO Score) with hover-reveal info, for use in an HTML Content visual.
	measure 'KPI Cards HTML' =
			VAR _total   = FORMAT(DIVIDE([Total Amount],1000000000),"0.0") & "B"
			VAR _loans   = FORMAT([Total Loan],"#,##0")
			VAR _rate    = FORMAT([AVG Interest Rate],"0.0") & "%"
			VAR _default = FORMAT([AVG Default Rate],"0.0%")
			VAR _fico    = FORMAT([Avg FICO Score],"0")
			
			VAR _maxY = MAX(dim_date[year])
			VAR _prevY = _maxY - 1
			
			VAR _amtCur  = CALCULATE([Total Amount], dim_date[year] = _maxY)
			VAR _amtPrev = CALCULATE([Total Amount], dim_date[year] = _prevY)
			VAR _amtChg  = DIVIDE(_amtCur - _amtPrev, _amtPrev)
			
			VAR _rateCur  = CALCULATE([AVG Interest Rate], dim_date[year] = _maxY)
			VAR _ratePrev = CALCULATE([AVG Interest Rate], dim_date[year] = _prevY)
			VAR _rateChg  = _rateCur - _ratePrev
			
			VAR _defCur  = CALCULATE([AVG Default Rate], dim_date[year] = _maxY)
			VAR _defPrev = CALCULATE([AVG Default Rate], dim_date[year] = _prevY)
			VAR _defChg  = _defCur - _defPrev
			
			VAR _ficoCur  = CALCULATE([Avg FICO Score], dim_date[year] = _maxY)
			VAR _ficoPrev = CALCULATE([Avg FICO Score], dim_date[year] = _prevY)
			VAR _ficoChg  = _ficoCur - _ficoPrev
			
			VAR _hasComp = NOT ISBLANK(_amtPrev) && _prevY >= MIN(dim_date[year])
			
			VAR _upSVG   = "<svg viewBox='0 0 24 24' width='11' height='11' fill='none' stroke-width='2.6' stroke-linecap='round' stroke-linejoin='round'><line x1='12' y1='19' x2='12' y2='5'></line><polyline points='6 11 12 5 18 11'></polyline></svg>"
			VAR _dnSVG   = "<svg viewBox='0 0 24 24' width='11' height='11' fill='none' stroke-width='2.6' stroke-linecap='round' stroke-linejoin='round'><line x1='12' y1='5' x2='12' y2='19'></line><polyline points='18 13 12 19 6 13'></polyline></svg>"
			
			VAR _amtChip  = IF(_hasComp, "<div class='trend " & IF(_amtChg>=0,"good","bad") & "'>" & IF(_amtChg>=0,_upSVG,_dnSVG) & "<span>" & FORMAT(ABS(_amtChg),"0.0%") & " vs " & _prevY & "</span></div>", "")
			VAR _rateChip = IF(_hasComp, "<div class='trend neutral'>" & IF(_rateChg>=0,_upSVG,_dnSVG) & "<span>" & FORMAT(ABS(_rateChg),"0.00") & " pts vs " & _prevY & "</span></div>", "")
			VAR _defChip  = IF(_hasComp, "<div class='trend " & IF(_defChg<=0,"good","bad") & "'>" & IF(_defChg>=0,_upSVG,_dnSVG) & "<span>" & FORMAT(ABS(_defChg),"0.0%") & " pts vs " & _prevY & "</span></div>", "")
			VAR _ficoChip = IF(_hasComp, "<div class='trend " & IF(_ficoChg>=0,"good","bad") & "'>" & IF(_ficoChg>=0,_upSVG,_dnSVG) & "<span>" & FORMAT(ABS(_ficoChg),"0") & " pts vs " & _prevY & "</span></div>", "")
			
			VAR _html =
			"<!DOCTYPE html><html><head><meta charset='UTF-8'><style>
			  * { box-sizing: border-box; margin:0; padding:0; font-family: 'Segoe UI', Arial, sans-serif; }
			  body { background: transparent; padding: 8px; }
			  .row { display:flex; gap:14px; }
			  .card { flex:1; background:#fff; border:1px solid #edf0f5; border-radius:14px; padding:16px 18px; position:relative; overflow:hidden; min-height:112px; box-shadow:0 1px 3px rgba(16,24,40,.06); transition: box-shadow .25s ease, transform .25s ease; cursor:default; }
			  .card:hover { box-shadow:0 12px 26px rgba(16,24,40,.18); transform: translateY(-2px); }
			  .label { font-size:11.5px; font-weight:700; color:#7a8194; letter-spacing:.5px; }
			  .value { font-size:29px; font-weight:700; color:#1a1d29; margin-top:5px; line-height:1.05; }
			  .sub { font-size:11px; color:#98a0b3; margin-top:5px; }
			  .red .value { color:#e6483e; }
			  .red .sub { color:#e6483e; }
			  .icon { position:absolute; top:12px; right:12px; width:30px; height:30px; border-radius:9px; background:#f2f4f8; display:flex; align-items:center; justify-content:center; }
			  .red .icon { background:#fdeceb; }
			  .icon svg { width:16px; height:16px; }
			  .trend { display:inline-flex; align-items:center; gap:4px; margin-top:9px; font-size:11px; font-weight:600; padding:3px 8px 3px 6px; border-radius:999px; width:fit-content; }
			  .trend svg { flex-shrink:0; }
			  .trend.good { background:#eaf7ef; color:#1c9a5b; }
			  .trend.good svg{ stroke:#1c9a5b; }
			  .trend.bad { background:#fdeceb; color:#d9432f; }
			  .trend.bad svg{ stroke:#d9432f; }
			  .trend.neutral { background:#f2f4f8; color:#5b6272; }
			  .trend.neutral svg{ stroke:#5b6272; }
			  .info-panel { position:absolute; inset:0; background:linear-gradient(135deg,#7a5240,#4a2f24); color:#f3e3d3; padding:18px 20px; display:flex; flex-direction:column; justify-content:center; gap:8px; transform:translateX(-105%); transition:transform .35s cubic-bezier(.4,0,.2,1); z-index:2; }
			  .card:hover .info-panel { transform:translateX(0); }
			  .info-title { font-size:13px; font-weight:700; letter-spacing:.4px; color:#ffffff; text-transform:uppercase; display:flex; align-items:center; gap:8px; }
			  .info-title:before { content:''; width:4px; height:14px; border-radius:2px; background:#f0c49b; }
			  .info-text { font-size:14.5px; line-height:1.6; color:#fbf3ea; font-weight:400; }
			  .info-foot { font-size:11.5px; color:#f0c49b; font-weight:600; letter-spacing:.3px; border-top:1px solid rgba(255,255,255,.2); padding-top:8px; margin-top:2px; }
			</style></head><body>
			<div class='row'>
			
			  <div class='card'>
			    <div class='icon'><svg viewBox='0 0 24 24' fill='none' stroke='#5b6272' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='6' width='20' height='12' rx='2'></rect><circle cx='12' cy='12' r='2.5'></circle><path d='M6 6v0M18 18v0'></path></svg></div>
			    <div class='label'>TOTAL LOAN AMOUNT</div>
			    <div class='value'>$" & _total & "</div>
			    <div class='sub'>Across " & _loans & " loans</div>
			    " & _amtChip & "
			    <div class='info-panel'>
			      <div class='info-title'>Total Loan Amount</div>
			      <div class='info-text'>Sum of loan_amount across every originated loan &mdash; the total dollar volume funded across the entire portfolio.</div>
			      <div class='info-foot'>Stakeholder view: overall book size and growth</div>
			    </div>
			  </div>
			
			  <div class='card'>
			    <div class='icon'><svg viewBox='0 0 24 24' fill='none' stroke='#5b6272' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><line x1='4' y1='20' x2='20' y2='4'></line><circle cx='7' cy='7' r='2.5'></circle><circle cx='17' cy='17' r='2.5'></circle></svg></div>
			    <div class='label'>AVG INTEREST RATE</div>
			    <div class='value'>" & _rate & "</div>
			    <div class='sub'>Portfolio average</div>
			    " & _rateChip & "
			    <div class='info-panel'>
			      <div class='info-title'>Avg Interest Rate</div>
			      <div class='info-text'>Average interest_rate charged across all loans &mdash; reflects the overall risk-based pricing of the book.</div>
			      <div class='info-foot'>Stakeholder view: pricing trend vs prior year</div>
			    </div>
			  </div>
			
			  <div class='card red'>
			    <div class='icon'><svg viewBox='0 0 24 24' fill='none' stroke='#e6483e' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 2 2 20h20L12 2z'></path><line x1='12' y1='9' x2='12' y2='14'></line><circle cx='12' cy='17' r='0.8' fill='#e6483e'></circle></svg></div>
			    <div class='label'>DEFAULT RATE</div>
			    <div class='value'>" & _default & "</div>
			    <div class='sub'>Charged off loans</div>
			    " & _defChip & "
			    <div class='info-panel'>
			      <div class='info-title'>Default Rate</div>
			      <div class='info-text'>Share of loans with loan_status = 'Charged Off' out of all loans &mdash; the core credit-risk indicator for this book.</div>
			      <div class='info-foot'>Stakeholder view: primary risk signal, watch closely</div>
			    </div>
			  </div>
			
			  <div class='card'>
			    <div class='icon'><svg viewBox='0 0 24 24' fill='none' stroke='#5b6272' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M4 15a8 8 0 0 1 16 0'></path><line x1='12' y1='15' x2='16' y2='10'></line><circle cx='12' cy='15' r='1' fill='#5b6272'></circle></svg></div>
			    <div class='label'>AVG FICO SCORE</div>
			    <div class='value'>" & _fico & "</div>
			    <div class='sub'>Borrower average</div>
			    " & _ficoChip & "
			    <div class='info-panel'>
			      <div class='info-title'>Avg FICO Score</div>
			      <div class='info-text'>Average of each borrower's FICO range midpoint ((fico_range_low + fico_range_high)/2) &mdash; indicates overall borrower creditworthiness.</div>
			      <div class='info-foot'>Stakeholder view: credit quality trend</div>
			    </div>
			  </div>
			
			</div>
			</body></html>"
			RETURN _html
		displayFolder: HTML Visuals
		lineageTag: 6a66598d-d908-49b4-827a-4f1cf1029fd7

	/// Drives the column part of the combo chart when 8 or fewer distinct years are in the current selection; returns 0 otherwise so the line series takes over.
	measure 'Loan Column Series' =
			VAR SelectedYearCount =
			    CALCULATE(
			        COUNTROWS(SUMMARIZE(dim_date, dim_date[year])),
			        ALLSELECTED(dim_date)
			    )
			RETURN
			IF(
			    SelectedYearCount <= 8,
			    [Total Amount],
			    0
			)
		displayFolder: Combo Chart
		lineageTag: 21586cd5-1014-4922-b580-19c9f049391b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Drives the line part of the combo chart when more than 8 distinct years are in the current selection; returns blank otherwise so no line renders.
	measure 'Loan Line Series' =
			VAR SelectedYearCount =
			    CALCULATE(
			        COUNTROWS(SUMMARIZE(dim_date, dim_date[year])),
			        ALLSELECTED(dim_date)
			    )
			RETURN
			IF(
			    SelectedYearCount > 8,
			    [Total Amount],
			    BLANK()
			)
		displayFolder: Combo Chart
		lineageTag: 684da111-9993-4a17-9c88-016a58eb771b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Shared max scale for the primary and secondary axes of the combo chart: the highest yearly Total Amount in the current selection, plus 10% headroom.
	measure 'Loan Max Axis Dynamic' =
			MAXX(
			    SUMMARIZE(ALLSELECTED(dim_date), dim_date[year]),
			    [Total Amount]
			) * 1.1
		displayFolder: Combo Chart
		lineageTag: 500b85be-c019-4872-8b1b-b68b062cefa8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Loan Status Distribution donut with hover-reveal detail panels (icon, count, %, description), color-coded by risk: teal=paid, amber=current, red shades=loss/at-risk. For the HTML Content visual.
	measure 'Loan Status Donut HTML' =
			VAR _total   = [Total Loan]
			VAR _fp      = CALCULATE([Total Loan], dim_loan_status[loan_status]="Fully Paid")
			VAR _cur     = CALCULATE([Total Loan], dim_loan_status[loan_status]="Current")
			VAR _co      = CALCULATE([Total Loan], dim_loan_status[loan_status]="Charged Off")
			VAR _late1   = CALCULATE([Total Loan], dim_loan_status[loan_status]="Late (31-120 days)")
			VAR _grace   = CALCULATE([Total Loan], dim_loan_status[loan_status]="In Grace Period")
			VAR _late2   = CALCULATE([Total Loan], dim_loan_status[loan_status]="Late (16-30 days)")
			VAR _ncpfp   = CALCULATE([Total Loan], dim_loan_status[loan_status]="NCP Fully Paid")
			VAR _ncpco   = CALCULATE([Total Loan], dim_loan_status[loan_status]="NCP Charged Off")
			VAR _def     = CALCULATE([Total Loan], dim_loan_status[loan_status]="Default")
			VAR _totalF  = FORMAT(_total,"#,##0")
			VAR _fpF     = FORMAT(_fp,"#,##0")     & " loans (" & FORMAT(DIVIDE(_fp,_total),"0.0%") & ")"
			VAR _curF    = FORMAT(_cur,"#,##0")    & " loans (" & FORMAT(DIVIDE(_cur,_total),"0.0%") & ")"
			VAR _coF     = FORMAT(_co,"#,##0")     & " loans (" & FORMAT(DIVIDE(_co,_total),"0.0%") & ")"
			VAR _late1F  = FORMAT(_late1,"#,##0")  & " loans (" & FORMAT(DIVIDE(_late1,_total),"0.0%") & ")"
			VAR _graceF  = FORMAT(_grace,"#,##0")  & " loans (" & FORMAT(DIVIDE(_grace,_total),"0.0%") & ")"
			VAR _late2F  = FORMAT(_late2,"#,##0")  & " loans (" & FORMAT(DIVIDE(_late2,_total),"0.0%") & ")"
			VAR _ncpfpF  = FORMAT(_ncpfp,"#,##0")  & " loans (" & FORMAT(DIVIDE(_ncpfp,_total),"0.0%") & ")"
			VAR _ncpcoF  = FORMAT(_ncpco,"#,##0")  & " loans (" & FORMAT(DIVIDE(_ncpco,_total),"0.0%") & ")"
			VAR _defF    = FORMAT(_def,"#,##0")    & " loans (" & FORMAT(DIVIDE(_def,_total),"0.0%") & ")"
			VAR _html =
			"<!DOCTYPE html><html><head><meta charset='UTF-8'><style>
			  * { box-sizing:border-box; margin:0; padding:0; font-family:'Segoe UI',Arial,sans-serif; }
			  body { background:transparent; padding:8px; }
			  .card { background:#fff; border:1px solid #eef0f4; border-radius:14px; padding:16px 18px; box-shadow:0 1px 3px rgba(16,24,40,.06); }
			  .card-title { font-size:16px; font-weight:700; color:#1a1d29; }
			  .card-sub { font-size:12px; color:#8a7a6e; margin-top:2px; margin-bottom:6px; }
			  .donut-wrap svg { width:100%; height:auto; overflow:visible; }
			  .seg { cursor:pointer; transition:filter .15s ease; transform-origin:120px 120px; }
			  .seg:hover { filter:brightness(1.08) drop-shadow(0 0 3px rgba(0,0,0,.15)); }
			  .center-value { font-size:26px; font-weight:800; fill:#3d2b22; font-family:'Segoe UI',Arial,sans-serif; }
			  .center-label { font-size:10px; fill:#9c8672; font-family:'Segoe UI',Arial,sans-serif; letter-spacing:.3px; }
			  .info-card { width:100%; height:100%; border-radius:12px; padding:12px 14px; display:flex; flex-direction:column; justify-content:center; gap:6px; }
			  .info-top { display:flex; align-items:center; gap:8px; }
			  .info-icon { width:26px; height:26px; border-radius:8px; background:rgba(255,255,255,.25); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
			  .info-icon svg { width:14px; height:14px; }
			  .info-title { font-size:12px; font-weight:700; letter-spacing:.2px; }
			  .info-count { font-size:15px; font-weight:800; margin-top:2px; }
			  .info-desc { font-size:10.5px; line-height:1.45; opacity:.95; margin-top:2px; }
			  .info { opacity:0; transition:opacity .18s ease; pointer-events:none; }
			  .placeholder-card { display:flex; align-items:center; justify-content:center; text-align:center; font-size:11.5px; color:#a3968a; padding:14px; background:#faf7f4; border-radius:12px; height:100%; }
			  .fp:hover ~ .info-fp,
			  .cur:hover ~ .info-cur,
			  .co:hover ~ .info-co,
			  .late1:hover ~ .info-late1,
			  .grace:hover ~ .info-grace,
			  .late2:hover ~ .info-late2,
			  .ncpfp:hover ~ .info-ncpfp,
			  .ncpco:hover ~ .info-ncpco,
			  .def:hover ~ .info-def { opacity:1; }
			  .placeholder { opacity:1; transition:opacity .18s ease; }
			  .seg:hover ~ .placeholder { opacity:0; }
			</style></head><body>
			<div class='card'>
			  <div class='card-title'>Loan Status Distribution</div>
			  <div class='card-sub'>Portfolio health at a glance &mdash; hover a segment for details</div>
			  <div class='donut-wrap'>
			  <svg viewBox='0 0 480 240' xmlns='http://www.w3.org/2000/svg'>
			
			    <path class='seg fp' fill='#C99A5B' d='M138.86,212.92 A95,95 0 0 0 120,25 L120,62 A58,58 0 0 1 131.51,176.73 Z'></path>
			    <path class='seg cur' fill='#7A5240' d='M43.40,64.41 A95,95 0 0 0 138.86,212.92 L131.51,176.73 A58,58 0 0 1 73.23,86.06 Z'></path>
			    <path class='seg co' fill='#A8362A' d='M100.31,27.30 A95,95 0 0 0 43.40,64.41 L73.23,86.06 A58,58 0 0 1 107.98,63.40 Z'></path>
			    <path class='seg late1' fill='#C15A3E' d='M103.51,26.44 A95,95 0 0 0 100.31,27.30 L107.98,63.40 A58,58 0 0 1 109.93,62.88 Z'></path>
			    <path class='seg grace' fill='#E8B4A0' d='M106.80,26.16 A95,95 0 0 0 103.51,26.44 L109.93,62.88 A58,58 0 0 1 111.94,62.71 Z'></path>
			    <path class='seg late2' fill='#D98F73' d='M110.10,25.86 A95,95 0 0 0 106.80,26.16 L111.94,62.71 A58,58 0 0 1 113.96,62.53 Z'></path>
			    <path class='seg ncpfp' fill='#E3C79A' d='M113.41,25.58 A95,95 0 0 0 110.10,25.86 L113.96,62.53 A58,58 0 0 1 115.98,62.35 Z'></path>
			    <path class='seg ncpco' fill='#8B2A20' d='M116.70,25.28 A95,95 0 0 0 113.41,25.58 L115.98,62.35 A58,58 0 0 1 117.99,62.17 Z'></path>
			    <path class='seg def' fill='#5C1B14' d='M120,25 A95,95 0 0 0 116.70,25.28 L117.99,62.17 A58,58 0 0 1 120,62 Z'></path>
			
			    <text x='120' y='116' text-anchor='middle' class='center-value'>" & _totalF & "</text>
			    <text x='120' y='134' text-anchor='middle' class='center-label'>TOTAL LOANS</text>
			
			    <foreignObject class='placeholder' x='250' y='60' width='215' height='110'><div xmlns='http://www.w3.org/1999/xhtml' class='placeholder-card'>Hover a slice on the donut to see details for that loan status</div></foreignObject>
			
			    <foreignObject class='info info-fp' x='250' y='45' width='215' height='140'><div xmlns='http://www.w3.org/1999/xhtml' class='info-card' style='background:linear-gradient(135deg,#C99A5B,#a67c42); color:#3a2c17'><div class='info-top'><div class='info-icon'><svg viewBox='0 0 24 24' fill='none' stroke='#3a2c17' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'></circle><path d='M8 12.5l2.5 2.5L16 9'></path></svg></div><div class='info-title'>Fully Paid</div></div><div class='info-count'>" & _fpF & "</div><div class='info-desc'>Loan repaid in full &mdash; the healthiest outcome in the portfolio.</div></div></foreignObject>
			
			    <foreignObject class='info info-cur' x='250' y='45' width='215' height='140'><div xmlns='http://www.w3.org/1999/xhtml' class='info-card' style='background:linear-gradient(135deg,#7A5240,#5c3c2d); color:#fdf3ea'><div class='info-top'><div class='info-icon'><svg viewBox='0 0 24 24' fill='none' stroke='#fdf3ea' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'></circle><path d='M12 7v5l3.5 2'></path></svg></div><div class='info-title'>Current</div></div><div class='info-count'>" & _curF & "</div><div class='info-desc'>Actively being repaid on schedule; no missed payments yet.</div></div></foreignObject>
			
			    <foreignObject class='info info-co' x='250' y='45' width='215' height='140'><div xmlns='http://www.w3.org/1999/xhtml' class='info-card' style='background:linear-gradient(135deg,#A8362A,#7a231b); color:#fdf3ea'><div class='info-top'><div class='info-icon'><svg viewBox='0 0 24 24' fill='none' stroke='#fdf3ea' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'></circle><path d='M9 9l6 6M15 9l-6 6'></path></svg></div><div class='info-title'>Charged Off</div></div><div class='info-count'>" & _coF & "</div><div class='info-desc'>Written off as a loss after prolonged non-payment &mdash; the core default outcome.</div></div></foreignObject>
			
			    <foreignObject class='info info-late1' x='250' y='45' width='215' height='140'><div xmlns='http://www.w3.org/1999/xhtml' class='info-card' style='background:linear-gradient(135deg,#C15A3E,#93402c); color:#fdf3ea'><div class='info-top'><div class='info-icon'><svg viewBox='0 0 24 24' fill='none' stroke='#fdf3ea' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 3 2 20h20L12 3z'></path><line x1='12' y1='10' x2='12' y2='14'></line><circle cx='12' cy='17' r='0.7' fill='#fdf3ea'></circle></svg></div><div class='info-title'>Late (31-120 days)</div></div><div class='info-count'>" & _late1F & "</div><div class='info-desc'>Seriously delinquent; high risk of rolling into Charged Off.</div></div></foreignObject>
			
			    <foreignObject class='info info-grace' x='250' y='45' width='215' height='140'><div xmlns='http://www.w3.org/1999/xhtml' class='info-card' style='background:linear-gradient(135deg,#E8B4A0,#cf8f77); color:#4a2b1f'><div class='info-top'><div class='info-icon' style='background:rgba(0,0,0,.1)'><svg viewBox='0 0 24 24' fill='none' stroke='#4a2b1f' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M6 3h12M6 21h12M7 3c0 5 5 6 5 9s-5 4-5 9M17 3c0 5-5 6-5 9s5 4 5 9'></path></svg></div><div class='info-title'>In Grace Period</div></div><div class='info-count'>" & _graceF & "</div><div class='info-desc' style='opacity:.85'>Payment just missed its due date; early-stage flag, not yet a loss.</div></div></foreignObject>
			
			    <foreignObject class='info info-late2' x='250' y='45' width='215' height='140'><div xmlns='http://www.w3.org/1999/xhtml' class='info-card' style='background:linear-gradient(135deg,#D98F73,#b66a4f); color:#3d241a'><div class='info-top'><div class='info-icon' style='background:rgba(0,0,0,.1)'><svg viewBox='0 0 24 24' fill='none' stroke='#3d241a' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 3 2 20h20L12 3z'></path><line x1='12' y1='10' x2='12' y2='14'></line><circle cx='12' cy='17' r='0.7' fill='#3d241a'></circle></svg></div><div class='info-title'>Late (16-30 days)</div></div><div class='info-count'>" & _late2F & "</div><div class='info-desc'>Early delinquency stage; still recoverable but worth watching.</div></div></foreignObject>
			
			    <foreignObject class='info info-ncpfp' x='250' y='45' width='215' height='140'><div xmlns='http://www.w3.org/1999/xhtml' class='info-card' style='background:linear-gradient(135deg,#E3C79A,#c7a06a); color:#4a3a1f'><div class='info-top'><div class='info-icon' style='background:rgba(0,0,0,.1)'><svg viewBox='0 0 24 24' fill='none' stroke='#4a3a1f' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'></circle><path d='M8 12.5l2.5 2.5L16 9'></path></svg></div><div class='info-title'>NCP Fully Paid</div></div><div class='info-count'>" & _ncpfpF & "</div><div class='info-desc'>Fully repaid loan outside the standard consumer program track.</div></div></foreignObject>
			
			    <foreignObject class='info info-ncpco' x='250' y='45' width='215' height='140'><div xmlns='http://www.w3.org/1999/xhtml' class='info-card' style='background:linear-gradient(135deg,#8B2A20,#5c1b14); color:#fdf3ea'><div class='info-top'><div class='info-icon'><svg viewBox='0 0 24 24' fill='none' stroke='#fdf3ea' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'></circle><path d='M9 9l6 6M15 9l-6 6'></path></svg></div><div class='info-title'>NCP Charged Off</div></div><div class='info-count'>" & _ncpcoF & "</div><div class='info-desc'>Written off as a loss outside the standard consumer program track.</div></div></foreignObject>
			
			    <foreignObject class='info info-def' x='250' y='45' width='215' height='140'><div xmlns='http://www.w3.org/1999/xhtml' class='info-card' style='background:linear-gradient(135deg,#5C1B14,#3a100b); color:#fdf3ea'><div class='info-top'><div class='info-icon'><svg viewBox='0 0 24 24' fill='none' stroke='#fdf3ea' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polygon points='7.5,2 16.5,2 22,7.5 22,16.5 16.5,22 7.5,22 2,16.5 2,7.5'></polygon><line x1='12' y1='8' x2='12' y2='13'></line><circle cx='12' cy='16' r='0.7' fill='#fdf3ea'></circle></svg></div><div class='info-title'>Default</div></div><div class='info-count'>" & _defF & "</div><div class='info-desc'>Formally defaulted &mdash; the most severe non-payment outcome.</div></div></foreignObject>
			
			  </svg>
			  </div>
			</div>
			</body></html>"
			RETURN _html
		displayFolder: HTML Visuals
		lineageTag: ace839df-2de1-4b54-a91e-928e9a290299

	/// Loan Overview hero banner (HTML Content visual): handshake photo with brown gradient overlay, headline story 'Why People Borrow' (share of loans refinancing debt, share on 36-month terms, top state share) with a hover-reveal borrower profile (avg income, DTI, avg loan size, Grade B+C share). Does not repeat the top KPI cards. Period label follows the year slicer.
	measure 'Loan Overview Hero' =
			VAR _y1 = MIN(dim_date[year])
			VAR _y2 = MAX(dim_date[year])
			VAR _period = IF(_y1 = _y2, FORMAT(_y1,"0"), FORMAT(_y1,"0") & " &ndash; " & FORMAT(_y2,"0"))
			VAR _loans = [Total Loan]
			VAR _refiF = FORMAT(DIVIDE(CALCULATE([Total Loan], dim_purpose[purpose] IN {"debt_consolidation","credit_card"}), _loans),"0%")
			VAR _term36F = FORMAT(DIVIDE(CALCULATE([Total Loan], fact_loan[term_months] = 36), _loans),"0%")
			VAR _stateT = TOPN(1, VALUES(dim_geography[borrower_state]), [Total Loan], DESC)
			VAR _state = MAXX(_stateT, dim_geography[borrower_state])
			VAR _stateF = FORMAT(DIVIDE(CALCULATE([Total Loan], dim_geography[borrower_state] = _state), _loans),"0%")
			VAR _incF = "$" & FORMAT(DIVIDE(AVERAGE(fact_loan[win_annual_inc]),1000),"0") & "K"
			VAR _dtiF = FORMAT([AVG DTI],"0.0") & "%"
			VAR _avgF = "$" & FORMAT(DIVIDE([Total Amount],_loans),"#,##0")
			VAR _bcF = FORMAT(DIVIDE(CALCULATE([Total Loan], dim_grade[grade] IN {"B","C"}), _loans),"0.0%")
			VAR _img = "https://i.postimg.cc/j57KFZTw/pexels-pavel-danilyuk-8112186.jpg"
			VAR _html =
			"<div style='font-family:Jost,Segoe UI,system-ui,sans-serif;border-radius:16px;position:relative;overflow:hidden;height:100vh;width:100%;cursor:pointer;'>
			<style>
			  html,body{ overflow:hidden!important; margin:0; padding:0; height:100vh; width:100%; background:transparent!important }
			  @keyframes imgIn{ 0%{opacity:0} 100%{opacity:1} }
			  @keyframes imgDrift{ 0%{transform:translateX(0)} 100%{transform:translateX(-3%)} }
			  .bg-img{ position:absolute; top:0; left:0; width:106%; height:100%; object-fit:cover; opacity:0; animation:imgIn 1.5s ease .3s forwards, imgDrift 25s ease-in-out 1s infinite alternate; border-radius:16px }
			  .ve-wrap{ position:relative; width:100%; height:100%; overflow:hidden; transition:box-shadow .3s ease }
			  .ve-wrap:hover{ box-shadow:0 0 0 1px rgba(201,142,58,.2) }
			  .ve-over{ position:absolute; top:0; left:0; width:100%; height:100%; background:linear-gradient(135deg,#4a2f24,#7a5240); color:#ffffff; padding:22px; opacity:0; transition:opacity .35s ease; display:flex; flex-direction:column; justify-content:center; box-sizing:border-box; pointer-events:none }
			  .ve-wrap:hover .ve-over{ opacity:1; pointer-events:auto }
			  .t{ color:#ffffff; text-shadow:0 1px 3px rgba(0,0,0,.4) }
			  .row{ display:flex; align-items:center; gap:12px; padding:6px 0; border-top:1px solid rgba(255,255,255,.22) }
			  .val{ min-width:66px; font-size:27px; font-weight:700; color:#ffffff; line-height:1; font-family:Cormorant Garamond,Georgia,serif; text-shadow:0 1px 3px rgba(0,0,0,.4) }
			  .lbl{ font-size:14px; line-height:1.3; color:#ffffff; text-shadow:0 1px 3px rgba(0,0,0,.4) }
			</style>
			<div class='ve-wrap'>
			  <div style='position:relative;height:100%;'>
			    <div style='position:absolute;top:0;left:0;width:100%;height:100%;background:#4a2f24;'></div>
			    <img class='bg-img' style='object-position:50% 40%;' src='" & _img & "' />
			    <div style='position:absolute;top:0;left:0;width:100%;height:100%;background:linear-gradient(90deg,rgba(74,47,36,.70) 0%,rgba(74,47,36,.48) 55%,rgba(74,47,36,.28) 100%);'></div>
			    <div style='position:relative;padding:16px 22px;display:flex;flex-direction:column;justify-content:center;height:100%;box-sizing:border-box;gap:5px;'>
			      <div style='display:inline-flex;align-items:center;background:rgba(255,255,255,.18);padding:4px 11px;border-radius:999px;width:fit-content;'>
			        <span class='t' style='font-size:12px;font-weight:500;letter-spacing:1.4px;'>PORTFOLIO &middot; " & _period & "</span>
			      </div>
			      <div class='t' style='font-size:28px;font-weight:700;line-height:1.1;font-family:Cormorant Garamond,Georgia,serif;margin-bottom:3px;'>Why People Borrow</div>
			      <div class='row'><div class='val'>" & _refiF & "</div><div class='lbl'>of loans refinance existing debt</div></div>
			      <div class='row'><div class='val'>" & _term36F & "</div><div class='lbl'>choose the 36-month term</div></div>
			      <div class='row'><div class='val'>" & _stateF & "</div><div class='lbl'>of loans come from " & _state & "</div></div>
			      <div class='t' style='font-size:12.5px;font-weight:400;margin-top:1px;opacity:.9;'>Hover for the borrower profile</div>
			    </div>
			  </div>
			  <div class='ve-over'>
			    <div style='display:inline-flex;align-items:center;background:rgba(255,255,255,.18);padding:4px 11px;border-radius:999px;margin-bottom:12px;width:fit-content;'>
			      <span class='t' style='font-size:12px;font-weight:500;letter-spacing:1.4px;'>BORROWER PROFILE</span>
			    </div>
			    <div class='t' style='font-size:15px;font-weight:400;line-height:1.55;'>The average borrower earns about <b>" & _incF & "</b> a year, carries a debt-to-income ratio of <b>" & _dtiF & "</b>, and borrows roughly <b>" & _avgF & "</b> per loan. Grades B and C make up <b>" & _bcF & "</b> of all loans.</div>
			    <div style='margin-top:14px;height:2px;width:60px;border-radius:999px;background:linear-gradient(90deg,#f0c49b,#7a5240,transparent);'></div>
			  </div>
			</div>
			</div>"
			RETURN _html
		displayFolder: HTML Visuals
		lineageTag: 2b406a74-f538-4e7e-b783-19974fbfe60a

	/// Page title block for the Loan Overview page (HTML Content visual): large serif title, dot-separated subtitle, copper gradient rule, and a small period label that follows the year slicer. Transparent background so it sits on the page colour.
	measure 'Page Title HTML' =
			VAR _y1 = MIN(dim_date[year])
			VAR _y2 = MAX(dim_date[year])
			VAR _period = IF(_y1 = _y2, FORMAT(_y1,"0"), FORMAT(_y1,"0") & " &ndash; " & FORMAT(_y2,"0"))
			VAR _html =
			"<div style='font-family:Jost,Segoe UI,system-ui,sans-serif;height:100vh;width:100%;box-sizing:border-box;'>
			<style>
			  html,body{ overflow:hidden!important; margin:0; padding:0; height:100vh; width:100%; background:transparent!important }
			  .wrap{ height:100%; width:100%; display:flex; flex-direction:column; justify-content:space-between; box-sizing:border-box; padding:2px 0 0 0 }
			  .top{ display:flex; align-items:flex-end; justify-content:space-between; gap:16px }
			  .ttl{ font-family:Cormorant Garamond,Georgia,serif; font-size:38px; font-weight:600; color:#3b241b; line-height:1.02; letter-spacing:-.2px }
			  .sub{ font-size:14px; font-weight:400; color:#6b5a4f; margin-top:6px; letter-spacing:.4px }
			  .per{ font-size:12px; font-weight:500; letter-spacing:1.6px; color:#6b5a4f; padding-bottom:3px; white-space:nowrap }
			  .per b{ color:#a4501a; font-weight:600 }
			  .rule{ height:3px; width:100%; border-radius:999px; background:linear-gradient(90deg,#d9772b 0%,#e9a26a 55%,rgba(233,162,106,0) 100%); margin-bottom:2px }
			</style>
			<div class='wrap'>
			  <div class='top'>
			    <div>
			      <div class='ttl'>Loan Overview</div>
			      <div class='sub'>Volume &middot; Grade &middot; Status &middot; Purpose</div>
			    </div>
			    <div class='per'>PERIOD &nbsp;<b>" & _period & "</b></div>
			  </div>
			  <div class='rule'></div>
			</div>
			</div>"
			RETURN _html
		displayFolder: HTML Visuals
		lineageTag: 1483998c-a949-421a-bcee-cc2975e1167a

	/// Risk Analysis hero card (HTML Content visual): full-bleed photo (financial paperwork, desk lamp) with a dark red-brown wash overlay, tag, big headline, live default-rate stat and multiple vs Grade A, explanatory paragraph. Hover reveals worst-term and safe-grade comparison as a bonus layer.
	measure 'Risk Hero HTML' =
			VAR _default = FORMAT([AVG Default Rate],"0.0%")
			
			VAR _worstGradeT = TOPN(1, VALUES(dim_grade[grade]), [AVG Default Rate], DESC)
			VAR _worstGrade  = MAXX(_worstGradeT, dim_grade[grade])
			VAR _worstGradeVal = CALCULATE([AVG Default Rate], dim_grade[grade] = _worstGrade)
			VAR _worstGradeR = FORMAT(_worstGradeVal, "0.0%")
			
			VAR _bestGradeT = TOPN(1, VALUES(dim_grade[grade]), [AVG Default Rate], ASC)
			VAR _bestGrade  = MAXX(_bestGradeT, dim_grade[grade])
			VAR _bestGradeVal = CALCULATE([AVG Default Rate], dim_grade[grade] = _bestGrade)
			VAR _bestGradeR = FORMAT(_bestGradeVal, "0.0%")
			
			VAR _multiple = FORMAT(DIVIDE(_worstGradeVal, _bestGradeVal), "0.0") & "x"
			
			VAR _worstTermT = TOPN(1, VALUES(fact_loan[term_months]), [AVG Default Rate], DESC)
			VAR _worstTerm  = MAXX(_worstTermT, fact_loan[term_months])
			VAR _worstTermR = FORMAT(CALCULATE([AVG Default Rate], fact_loan[term_months] = _worstTerm), "0.0%")
			
			VAR _img = "https://i.ibb.co/Gh39KxV/pexels-bia-limova-1908542654-33175673.jpg"
			
			VAR _html =
			"<div style='font-family:Jost,Segoe UI,system-ui,sans-serif;position:relative;overflow:hidden;height:100vh;width:100%;border-radius:14px;cursor:pointer;'>
			<style>
			  html,body{ overflow:hidden!important; margin:0; padding:0; height:100vh; width:100%; background:transparent!important }
			  @keyframes imgIn{ 0%{opacity:0} 100%{opacity:1} }
			  @keyframes imgDrift{ 0%{transform:scale(1.04) translateX(0)} 100%{transform:scale(1.04) translateX(-2%)} }
			  .bg-img{ position:absolute; top:0; left:0; width:106%; height:100%; object-fit:cover; object-position:50% 35%; opacity:0; animation:imgIn 1.2s ease .2s forwards, imgDrift 26s ease-in-out 1s infinite alternate; }
			  .ve-wrap{ position:relative; width:100%; height:100%; overflow:hidden; border-radius:14px; }
			  .face{ position:relative; height:100%; width:100%; box-sizing:border-box; }
			  .overlay{ position:absolute; top:0; left:0; width:100%; height:100%; background:linear-gradient(155deg,rgba(36,20,17,.55) 0%,rgba(30,16,14,.72) 45%,rgba(18,9,8,.9) 100%); }
			  .content{ position:relative; z-index:1; padding:20px 22px; display:flex; flex-direction:column; justify-content:center; height:100%; box-sizing:border-box; gap:6px; }
			  .tag{ display:inline-flex; align-items:center; gap:7px; background:rgba(255,255,255,.14); padding:4px 11px; border-radius:999px; width:fit-content; }
			  .dot{ width:6px; height:6px; border-radius:50%; background:#D9432F; }
			  .tagtxt{ font-size:10.5px; font-weight:600; letter-spacing:1.5px; color:#f0a99e; }
			  .ttl{ font-family:Cormorant Garamond,Georgia,serif; font-size:25px; font-weight:700; color:#ffffff; line-height:1.08; text-shadow:0 1px 4px rgba(0,0,0,.4); margin-top:6px; }
			  .subline{ font-size:12.5px; font-weight:400; color:#e6d3cc; margin-top:3px; }
			  .num{ font-family:Cormorant Garamond,Georgia,serif; font-size:44px; font-weight:700; color:#ffffff; line-height:1; text-shadow:0 2px 6px rgba(0,0,0,.45); margin-top:6px; }
			  .para{ font-size:12px; font-weight:300; color:#e6d8d2; line-height:1.5; margin-top:6px; max-width:96%; }
			  .hint{ font-size:10.5px; color:#c9beb5; margin-top:8px; opacity:.85; }
			  .panel{ position:absolute; inset:0; background:linear-gradient(155deg,#1e1613,#2a1a17); color:#fff; padding:20px 22px; display:flex; flex-direction:column; justify-content:center; gap:9px; opacity:0; transition:opacity .35s ease; pointer-events:none; z-index:2; box-sizing:border-box; }
			  .ve-wrap:hover .panel{ opacity:1; pointer-events:auto; }
			  .ptitle{ font-size:10.5px; font-weight:700; letter-spacing:1.2px; color:#f0a99e; text-transform:uppercase; }
			  .row{ display:flex; align-items:baseline; gap:10px; border-top:1px solid rgba(255,255,255,.12); padding-top:8px; }
			  .rv{ font-size:18px; font-weight:700; color:#f0a99e; min-width:52px; font-family:Cormorant Garamond,Georgia,serif; }
			  .rl{ font-size:12px; color:#d8ccc3; line-height:1.3; }
			  .safe{ font-size:11.5px; color:#9fc9ad; margin-top:4px; }
			</style>
			<div class='ve-wrap'>
			  <div class='face'>
			    <img class='bg-img' src='" & _img & "' />
			    <div class='overlay'></div>
			    <div class='content'>
			      <div class='tag'><span class='dot'></span><span class='tagtxt'>PORTFOLIO RISK</span></div>
			      <div class='ttl'>Where Risk Concentrates</div>
			      <div class='subline'>Grade " & _worstGrade & " defaults " & _multiple & " more than Grade " & _bestGrade & "</div>
			      <div class='num'>" & _worstGradeR & "</div>
			      <div class='para'>Grade " & _worstGrade & " loans default at " & _worstGradeR & ", versus just " & _bestGradeR & " for Grade " & _bestGrade & ". Risk climbs steadily across every grade in between, and the riskiest tiers carry outsized loss potential relative to their share of the book.</div>
			      <div class='hint'>Hover for term breakdown</div>
			    </div>
			  </div>
			  <div class='panel'>
			    <div class='ptitle'>Beyond grade</div>
			    <div class='row'><div class='rv'>" & _worstTermR & "</div><div class='rl'>default rate on " & _worstTerm & "-month loans &mdash; the longer term</div></div>
			    <div class='row'><div class='rv'>" & _default & "</div><div class='rl'>overall portfolio default rate, across every grade and term</div></div>
			    <div class='safe'>Grade " & _bestGrade & " stays safest at just " & _bestGradeR & ".</div>
			  </div>
			</div>
			</div>"
			RETURN _html
		displayFolder: HTML Visuals - Risk
		lineageTag: cbf56657-2d67-43f0-a989-0859dac82395

	/// Default Rate vs Fully Paid Rate vs In-Progress, shown as an honest 3-segment horizontal proportion bar (HTML Content visual) that sums to 100%: green = Fully Paid/NCP Fully Paid, grey = Current/Late/Grace Period (still in progress), red = Charged Off/Default/NCP Charged Off.
	measure 'Risk Outcome Split HTML' =
			VAR _total = COUNTROWS(fact_loan)
			VAR _paid = CALCULATE(COUNTROWS(fact_loan), dim_loan_status[loan_status] IN {"Fully Paid","NCP Fully Paid"})
			VAR _bad  = CALCULATE(COUNTROWS(fact_loan), dim_loan_status[loan_status] IN {"Charged Off","Default","NCP Charged Off"})
			VAR _prog = _total - _paid - _bad
			
			VAR _paidPct = DIVIDE(_paid,_total)
			VAR _progPct = DIVIDE(_prog,_total)
			VAR _badPct  = DIVIDE(_bad,_total)
			
			VAR _paidF = FORMAT(_paidPct,"0.0%")
			VAR _progF = FORMAT(_progPct,"0.0%")
			VAR _badF  = FORMAT(_badPct,"0.0%")
			
			VAR _paidW = FORMAT(_paidPct*100,"0.0")
			VAR _progW = FORMAT(_progPct*100,"0.0")
			VAR _badW  = FORMAT(_badPct*100,"0.0")
			
			VAR _html =
			"<div style='font-family:Jost,Segoe UI,system-ui,sans-serif;height:100vh;width:100%;box-sizing:border-box;'>
			<style>
			  html,body{ overflow:hidden!important; margin:0; padding:0; height:100vh; width:100%; background:transparent!important }
			  .card{ height:100%; width:100%; box-sizing:border-box; background:#fff; border:1px solid #edf0f5; border-radius:14px; padding:20px 22px 30px; display:flex; flex-direction:column; justify-content:center; }
			  .hdr{ font-size:11.5px; font-weight:700; letter-spacing:.5px; color:#7a8194; margin-bottom:14px; }
			  .bar{ position:relative; height:34px; width:100%; border-radius:999px; overflow:hidden; display:flex; background:#f2f4f8; box-shadow:inset 0 0 0 1px #edf0f5; }
			  .seg{ height:100%; display:flex; align-items:center; justify-content:center; }
			  .seg.paid{ background:linear-gradient(90deg,#1c9a5b,#28b26c); width:" & _paidW & "%; }
			  .seg.prog{ background:linear-gradient(90deg,#c7ccd6,#b3b9c7); width:" & _progW & "%; }
			  .seg.bad{ background:linear-gradient(90deg,#e0574a,#d9432f); width:" & _badW & "%; }
			  .segtxt{ font-size:12px; font-weight:700; color:#ffffff; white-space:nowrap; text-shadow:0 1px 2px rgba(0,0,0,.15); }
			  .segtxt.dark{ color:#4a5265; text-shadow:none; }
			  .legend{ display:flex; justify-content:space-between; margin-top:10px; }
			  .lgitem{ display:flex; align-items:center; gap:6px; }
			  .sw{ width:9px; height:9px; border-radius:3px; }
			  .sw.paid{ background:#1c9a5b; }
			  .sw.prog{ background:#b3b9c7; }
			  .sw.bad{ background:#d9432f; }
			  .lgtxt{ font-size:11px; color:#5b6272; font-weight:500; }
			  .insight{ margin-top:18px; padding-top:16px; border-top:1px solid #edf0f5; }
			  .iline{ font-size:14.5px; line-height:1.6; color:#3f4657; font-weight:400; }
			  .iline b{ color:#1f2430; font-weight:700; }
			  .iline .r{ color:#d9432f; font-weight:700; }
			</style>
			<div class='card'>
			  <div class='hdr'>LOAN OUTCOME SPLIT &middot; ALL " & FORMAT(_total,"#,##0") & " LOANS</div>
			  <div class='bar'>
			    <div class='seg paid'><span class='segtxt'>" & _paidF & "</span></div>
			    <div class='seg prog'><span class='segtxt dark'>" & _progF & "</span></div>
			    <div class='seg bad'><span class='segtxt'>" & _badF & "</span></div>
			  </div>
			  <div class='legend'>
			    <div class='lgitem'><span class='sw paid'></span><span class='lgtxt'>Fully Paid</span></div>
			    <div class='lgitem'><span class='sw prog'></span><span class='lgtxt'>In Progress (Current, Late)</span></div>
			    <div class='lgitem'><span class='sw bad'></span><span class='lgtxt'>Charged Off / Default</span></div>
			  </div>
			  <div class='insight'>
			    <div class='iline'>Today's <span class='r'>" & _badF & "</span> charged-off share is a floor, not final: <b>" & _progF & "</b> of loans are still In Progress and yet to mature.</div>
			  </div>
			</div>
			</div>"
			RETURN _html
		displayFolder: HTML Visuals - Risk
		lineageTag: 7e5c53fa-5d81-419b-8668-d7e3c50c8f6d

	/// Dynamic insight line for the Default Rate by Purpose chart (HTML Content visual): states which purpose has the highest default rate and contrasts it with the purpose carrying the most loan volume, since the two are not the same.
	measure 'Risk Purpose Insight HTML' =
			VAR _worstT = TOPN(1, VALUES(dim_purpose[purpose]), [AVG Default Rate], DESC)
			VAR _worst  = MAXX(_worstT, dim_purpose[purpose])
			VAR _worstR = FORMAT(CALCULATE([AVG Default Rate], dim_purpose[purpose] = _worst), "0.1%")
			
			VAR _bigT = TOPN(1, VALUES(dim_purpose[purpose]), [Total Loan], DESC)
			VAR _big  = MAXX(_bigT, dim_purpose[purpose])
			VAR _bigR = FORMAT(CALCULATE([AVG Default Rate], dim_purpose[purpose] = _big), "0.1%")
			VAR _bigLoans = CALCULATE([Total Loan], dim_purpose[purpose] = _big)
			VAR _worstLoans = CALCULATE([Total Loan], dim_purpose[purpose] = _worst)
			VAR _multiple = FORMAT(DIVIDE(_bigLoans, _worstLoans), "0") & "x"
			
			VAR _sameOne = _worst = _big
			
			VAR _html =
			IF(
			    _sameOne,
			    "<div style='font-family:Jost,Segoe UI,system-ui,sans-serif;height:100vh;width:100%;box-sizing:border-box;display:flex;align-items:center;'><style>html,body{overflow:hidden!important;margin:0;padding:0;height:100vh;width:100%;background:transparent!important}</style><div style='font-size:13px;line-height:1.5;color:#5b6272;'><b style='color:#d9432f;'>" & UPPER(_worst) & "</b> loans default most often (" & _worstR & ") and also carry the most loan volume &mdash; the single largest source of portfolio risk.</div></div>",
			    "<div style='font-family:Jost,Segoe UI,system-ui,sans-serif;height:100vh;width:100%;box-sizing:border-box;display:flex;align-items:center;'><style>html,body{overflow:hidden!important;margin:0;padding:0;height:100vh;width:100%;background:transparent!important}</style><div style='font-size:13px;line-height:1.5;color:#5b6272;'><b style='color:#d9432f;'>" & UPPER(_worst) & "</b> loans default most often (" & _worstR & "), but <b style='color:#3b241b;'>" & UPPER(_big) & "</b> carries " & _multiple & " more loan volume at " & _bigR & " default &mdash; the bigger portfolio risk in dollar terms.</div></div>"
			)
			RETURN _html
		displayFolder: HTML Visuals - Risk
		lineageTag: e84cb285-b4fe-4061-a174-5263d2f7d57b

	/// Caption for the Default Rate Trend Over Years chart (HTML Content visual): flags that the most recent 1-2 years understate default rate because those loans have not had time to mature, so the line should not be read as risk improving.
	measure 'Risk Trend Caution HTML' =
			VAR _maxY = MAX(dim_date[year])
			VAR _cautionYears = _maxY - 1
			VAR _html =
			"<div style='font-family:Jost,Segoe UI,system-ui,sans-serif;height:100vh;width:100%;box-sizing:border-box;display:flex;align-items:center;'>
			<style>html,body{overflow:hidden!important;margin:0;padding:0;height:100vh;width:100%;background:transparent!important}</style>
			<div style='display:flex;align-items:flex-start;gap:8px;font-size:12px;line-height:1.5;color:#8a6a5a;background:#fdf3ee;border:1px solid #f0d9cd;border-radius:10px;padding:9px 12px;'>
			<span style='font-size:14px;'>&#9888;</span>
			<span><b style='color:#a4501a;'>" & _cautionYears & "&ndash;" & _maxY & " appear artificially low.</b> Loans issued that recently haven't had time to default &mdash; treat the drop as unmatured data, not improving risk.</span>
			</div>
			</div>"
			RETURN _html
		displayFolder: HTML Visuals - Risk
		lineageTag: 43a189b9-7c7a-45ed-95a8-3e205db82b76

	/// Risk Analysis multi-metric trend chart (HTML Content visual, self-contained SVG+JS): tabbed line chart switching between Default Rate, Interest Rate, Avg FICO, and Loan Volume by year. Shows PEAK/LOW callouts, YoY gain/drop markers, hover tooltip, and an auto-shown caution note on the Default Rate tab for the most recent unmatured years.
	measure 'Risk Trend Multi HTML' =
			VAR _tbl = ADDCOLUMNS(
			    SUMMARIZE(dim_date, dim_date[year]),
			    "DefRate", [AVG Default Rate],
			    "IntRate", [AVG Interest Rate],
			    "Fico", [Avg FICO Score],
			    "AmtB", DIVIDE([Total Amount],1000000000)
			)
			VAR _tblF = FILTER(_tbl, NOT ISBLANK([DefRate]))
			VAR _yearsCSV = CONCATENATEX(_tblF, FORMAT(dim_date[year],"0"), ",", dim_date[year], ASC)
			VAR _defCSV   = CONCATENATEX(_tblF, FORMAT(ROUND([DefRate]*100,2),"0.00"), ",", dim_date[year], ASC)
			VAR _intCSV   = CONCATENATEX(_tblF, FORMAT(ROUND([IntRate],2),"0.00"), ",", dim_date[year], ASC)
			VAR _ficoCSV  = CONCATENATEX(_tblF, FORMAT(ROUND([Fico],0),"0"), ",", dim_date[year], ASC)
			VAR _amtCSV   = CONCATENATEX(_tblF, FORMAT(ROUND([AmtB],2),"0.00"), ",", dim_date[year], ASC)
			VAR _maxY = MAXX(_tblF, dim_date[year])
			VAR _prevY = _maxY - 1
			
			VAR _style =
			"<style>
			*{box-sizing:border-box;margin:0;padding:0;}
			html,body{overflow:hidden;height:100vh;width:100%;background:transparent!important;font-family:'Jost',system-ui,sans-serif;}
			.tc{width:100%;height:100vh;display:flex;flex-direction:column;overflow:hidden;background:#fff;border:1px solid #edf0f5;border-radius:14px;}
			.tc-hdr{padding:16px 20px 6px;flex-shrink:0;display:flex;justify-content:space-between;align-items:flex-start;}
			.tag{display:inline-flex;align-items:center;gap:5px;background:rgba(217,160,43,.12);padding:3px 10px;border-radius:999px;margin-bottom:6px;}
			.tagtxt{font-size:9px;font-weight:600;letter-spacing:2px;color:#B8860F;}
			.ttl{font-size:16px;font-weight:600;color:#3D2F28;}
			.sub{font-size:11px;font-weight:300;color:#6B5D52;margin-top:1px;}
			.tabs{display:flex;gap:6px;margin-top:8px;}
			.tab{font-size:10.5px;font-weight:600;color:#7a8194;background:#f2f4f8;padding:5px 10px;border-radius:7px;cursor:pointer;transition:all .15s ease;}
			.tab.active{color:#fff;background:#6B5D52;}
			.hint{display:flex;align-items:center;gap:4px;justify-content:flex-end;}
			.hinttxt{font-size:8px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;color:#737378;}
			.legend{display:flex;align-items:center;gap:8px;margin-top:10px;justify-content:flex-end;}
			.lgi{display:inline-flex;align-items:center;gap:3px;}
			.lgbar{display:inline-block;width:2px;height:8px;border-radius:1px;}
			.lgtxt{font-size:7px;font-weight:500;color:#3D2F28;letter-spacing:.5px;}
			.summary{display:flex;align-items:center;gap:6px;margin-top:8px;}
			.deltapill{display:flex;align-items:center;gap:3px;padding:3px 8px;border-radius:20px;}
			.deltaval{font-size:12px;font-weight:600;}
			.rangeval{font-size:11px;font-weight:300;color:#737378;}
			.arrowlbl{font-size:11px;font-weight:500;color:#6B5D52;}
			.tc-chart{flex:1;position:relative;min-height:0;}
			.tc-chart svg{width:100%;height:100%;display:block;}
			.yr{font-family:'Jost',sans-serif;font-size:11px;fill:#98a0b3;text-anchor:middle;}
			.yr-hi{font-weight:600;}
			.grid{stroke:#EDF0F5;stroke-width:0.5;}
			#hoverTip{position:absolute;pointer-events:none;opacity:0;transition:opacity .15s ease;font-family:'Jost',sans-serif;background:rgba(255,255,255,.97);border-radius:10px;padding:8px 12px;box-shadow:0 2px 12px rgba(16,24,40,.12);border:1px solid #edf0f5;}
			#hoverTip .ht-val{font-size:12px;font-weight:700;color:#1a1d29;}
			#hoverTip .ht-row{display:flex;align-items:center;gap:4px;margin-top:3px;}
			#hoverTip .ht-prev{font-size:9px;font-weight:300;color:#98a0b3;}
			.caution{margin:0 20px 14px;display:flex;gap:7px;align-items:flex-start;font-size:11px;line-height:1.4;color:#8a6a5a;background:#fdf3ee;border:1px solid #f0d9cd;border-radius:9px;padding:7px 10px;flex-shrink:0;}
			</style>"
			
			VAR _js =
			"<script>
			(function(){
			var years=[" & _yearsCSV & "];
			var CHART_COLOR='#6B5D52';
			var cBest='#4A7A3B', cWorst='#A8524B', cMuted='#737378';
			var M={
			 def:{name:'Default Rate',fmt:function(v){return v.toFixed(1)+'%';}, vals:[" & _defCSV & "]},
			 int:{name:'Interest Rate',fmt:function(v){return v.toFixed(2)+'%';}, vals:[" & _intCSV & "]},
			 fico:{name:'Avg FICO',fmt:function(v){return Math.round(v)+'';}, vals:[" & _ficoCSV & "]},
			 amt:{name:'Loan Volume',fmt:function(v){return '$'+v.toFixed(1)+'B';}, vals:[" & _amtCSV & "]}
			};
			var order=['def','int','fico','amt'];
			var active='def';
			var maxY=" & _maxY & ", prevY=" & _prevY & ";
			
			var el=document.getElementById('chart');
			var hoverTip=document.getElementById('hoverTip');
			var cautionEl=document.getElementById('caution');
			var summaryEl=document.getElementById('summary');
			
			function buildTabs(){
			 var tb=document.getElementById('tabs');
			 tb.innerHTML='';
			 order.forEach(function(k){
			  var d=document.createElement('div');
			  d.className='tab'+(k===active?' active':'');
			  d.textContent=M[k].name;
			  d.addEventListener('click',function(){ active=k; buildTabs(); render(); });
			  tb.appendChild(d);
			 });
			}
			
			function smoothPath(points){
			 if(points.length<2) return '';
			 var d='M'+points[0].x+','+points[0].y;
			 for(var i=0;i<points.length-1;i++){
			  var p0=points[Math.max(0,i-1)],p1=points[i],p2=points[i+1],p3=points[Math.min(points.length-1,i+2)];
			  var t=0.35;
			  var c1x=p1.x+(p2.x-p0.x)*t, c1y=p1.y+(p2.y-p0.y)*t;
			  var c2x=p2.x-(p3.x-p1.x)*t, c2y=p2.y-(p3.y-p1.y)*t;
			  d+='C'+c1x+','+c1y+' '+c2x+','+c2y+' '+p2.x+','+p2.y;
			 }
			 return d;
			}
			
			function renderSummary(){
			 var metric=M[active];
			 var vals=metric.vals;
			 var first=vals[0], last=vals[vals.length-1];
			 var diff=last-first;
			 var isUp=diff>=0;
			 var pctChg = first!==0 ? Math.abs(diff/first*100).toFixed(1)+'%' : 'n/a';
			 var arrow = isUp ? '\u25B2' : '\u25BC';
			 var col = isUp ? cBest : cWorst;
			 var bg = isUp ? 'rgba(74,122,59,.1)' : 'rgba(168,82,75,.1)';
			 summaryEl.innerHTML =
			  ""<div class='deltapill' style='background:""+bg+""'><span style='color:""+col+"";font-size:10px;'>""+arrow+""</span><span class='deltaval' style='color:""+col+""'>""+pctChg+""</span></div>"" +
			  ""<span class='arrowlbl'>""+metric.fmt(first)+"" \u2192 ""+metric.fmt(last)+""</span>"" +
			  ""<span class='rangeval'>(""+years[0]+"" \u2014 ""+years[years.length-1]+"")</span>"";
			}
			
			function render(){
			 el.innerHTML='';
			 renderSummary();
			 var metric=M[active];
			 var vals=metric.vals;
			 if(vals.length<2) return;
			 var mx=Math.max.apply(null,vals), mn=Math.min.apply(null,vals);
			 var bestidx=vals.indexOf(mx), worstidx=vals.indexOf(mn);
			 var pad={l:38,r:34,t:38,b:34};
			 var W=el.offsetWidth||500, H=el.offsetHeight||200;
			 var cw=W-pad.l-pad.r, ch=H-pad.t-pad.b;
			 var range=mx-mn||1, dpad=range*0.22;
			 var dmin=mn-dpad, dmax=mx+dpad;
			 function xPos(i){ return pad.l+i*(cw/(vals.length-1)); }
			 function yPos(v){ return pad.t+ch-(((v-dmin)/(dmax-dmin))*ch); }
			 var ns='http://www.w3.org/2000/svg';
			 var svg=document.createElementNS(ns,'svg');
			 svg.setAttribute('viewBox','0 0 '+W+' '+H);
			 svg.setAttribute('preserveAspectRatio','none');
			 for(var g=0;g<4;g++){
			  var gy=pad.t+(ch/3)*g;
			  var gl=document.createElementNS(ns,'line');
			  gl.setAttribute('x1',pad.l-6); gl.setAttribute('x2',W-pad.r+6);
			  gl.setAttribute('y1',gy); gl.setAttribute('y2',gy);
			  gl.setAttribute('class','grid');
			  svg.appendChild(gl);
			 }
			 var pts=[];
			 for(var i=0;i<vals.length;i++){ pts.push({x:xPos(i),y:yPos(vals[i])}); }
			 var curveD=smoothPath(pts);
			 var areaD=curveD+'L'+pts[pts.length-1].x+','+(pad.t+ch)+'L'+pts[0].x+','+(pad.t+ch)+'Z';
			 var defs=document.createElementNS(ns,'defs');
			 var grad=document.createElementNS(ns,'linearGradient');
			 grad.setAttribute('id','ag'); grad.setAttribute('x1','0'); grad.setAttribute('y1','0'); grad.setAttribute('x2','0'); grad.setAttribute('y2','1');
			 var s1=document.createElementNS(ns,'stop'); s1.setAttribute('offset','0%'); s1.setAttribute('stop-color',CHART_COLOR); s1.setAttribute('stop-opacity','0.09');
			 var s2=document.createElementNS(ns,'stop'); s2.setAttribute('offset','100%'); s2.setAttribute('stop-color',CHART_COLOR); s2.setAttribute('stop-opacity','0.01');
			 grad.appendChild(s1); grad.appendChild(s2); defs.appendChild(grad); svg.appendChild(defs);
			 var area=document.createElementNS(ns,'path'); area.setAttribute('d',areaD); area.setAttribute('fill','url(#ag)'); svg.appendChild(area);
			 var yoys=[];
			 for(var j=1;j<vals.length;j++){ var pv=vals[j-1]; var yp=pv!==0?((vals[j]-pv)/Math.abs(pv)*100):0; yoys.push({i:j,pct:yp}); }
			 var sorted=yoys.slice().sort(function(a,b){return b.pct-a.pct;});
			 var mks = sorted.length>=4 ? sorted.slice(0,2).concat(sorted.slice(-2)) : sorted;
			 var used={}; used[bestidx]=1; used[worstidx]=1;
			 mks.forEach(function(m){
			  if(used[m.i]) return;
			  var isUp=m.pct>=0;
			  var mc=isUp?cBest:cWorst;
			  var mx2=pts[m.i].x, by=pad.t+ch;
			  var tk=document.createElementNS(ns,'line');
			  tk.setAttribute('x1',mx2); tk.setAttribute('x2',mx2); tk.setAttribute('y1',by); tk.setAttribute('y2',pts[m.i].y-14);
			  tk.setAttribute('stroke',mc); tk.setAttribute('stroke-width','1'); tk.setAttribute('stroke-opacity','0.25'); tk.setAttribute('stroke-dasharray','3,2');
			  svg.appendChild(tk);
			  var ml=document.createElementNS(ns,'text');
			  ml.setAttribute('x',mx2); ml.setAttribute('y',by+27); ml.setAttribute('text-anchor','middle');
			  ml.setAttribute('font-family','Jost,sans-serif'); ml.setAttribute('font-size','7px'); ml.setAttribute('font-weight','600');
			  ml.setAttribute('fill',mc); ml.setAttribute('fill-opacity','0.85');
			  ml.textContent=(isUp?'+':'')+m.pct.toFixed(1)+'%';
			  svg.appendChild(ml);
			 });
			 var line=document.createElementNS(ns,'path'); line.setAttribute('d',curveD); line.setAttribute('fill','none');
			 line.setAttribute('stroke',CHART_COLOR); line.setAttribute('stroke-width','2'); line.setAttribute('stroke-linecap','round'); line.setAttribute('stroke-linejoin','round');
			 svg.appendChild(line);
			 for(var i=0;i<pts.length;i++){
			  var isB=i===bestidx, isW=(i===worstidx && worstidx!==bestidx), isHi=isB||isW;
			  var yr=document.createElementNS(ns,'text');
			  yr.setAttribute('x',pts[i].x); yr.setAttribute('y',pad.t+ch+16);
			  yr.setAttribute('class','yr'+(isHi?' yr-hi':''));
			  if(isHi) yr.setAttribute('fill',isB?cBest:cWorst);
			  yr.textContent=String.fromCharCode(39)+String(years[i]).slice(2);
			  svg.appendChild(yr);
			  if(!isHi){
			   var vt=document.createElementNS(ns,'text');
			   vt.setAttribute('x',pts[i].x); vt.setAttribute('y',pts[i].y-12); vt.setAttribute('text-anchor','middle');
			   vt.setAttribute('font-family','Jost,sans-serif'); vt.setAttribute('font-size','10px'); vt.setAttribute('font-weight','400'); vt.setAttribute('fill',cMuted);
			   vt.textContent=metric.fmt(vals[i]);
			   svg.appendChild(vt);
			  }
			 }
			 function addCallout(idx,color,label){
			  var px=pts[idx].x, py=pts[idx].y, val=metric.fmt(vals[idx]), pillY=py-38;
			  var vline=document.createElementNS(ns,'line');
			  vline.setAttribute('x1',px); vline.setAttribute('y1',pillY+20); vline.setAttribute('x2',px); vline.setAttribute('y2',py-7);
			  vline.setAttribute('stroke',color); vline.setAttribute('stroke-width','1'); vline.setAttribute('stroke-dasharray','2,2'); vline.setAttribute('stroke-opacity','0.3');
			  svg.appendChild(vline);
			  var lbl=document.createElementNS(ns,'text');
			  lbl.setAttribute('x',px); lbl.setAttribute('y',pillY-5); lbl.setAttribute('text-anchor','middle'); lbl.setAttribute('fill',color); lbl.setAttribute('fill-opacity','0.6');
			  lbl.setAttribute('font-family','Jost,sans-serif'); lbl.setAttribute('font-size','7px'); lbl.setAttribute('font-weight','500'); lbl.setAttribute('letter-spacing','1.5');
			  lbl.textContent=label; svg.appendChild(lbl);
			  var pillW=58,pillH=20,pillR=10,pillX=px-pillW/2;
			  var pill=document.createElementNS(ns,'rect');
			  pill.setAttribute('x',pillX); pill.setAttribute('y',pillY); pill.setAttribute('width',pillW); pill.setAttribute('height',pillH); pill.setAttribute('rx',pillR);
			  pill.setAttribute('fill',color); pill.setAttribute('fill-opacity','0.12'); pill.setAttribute('stroke',color); pill.setAttribute('stroke-width','0.8'); pill.setAttribute('stroke-opacity','0.25');
			  svg.appendChild(pill);
			  var t1=document.createElementNS(ns,'text');
			  t1.setAttribute('x',px); t1.setAttribute('y',pillY+13.5); t1.setAttribute('text-anchor','middle'); t1.setAttribute('fill',color);
			  t1.setAttribute('font-family','Jost,sans-serif'); t1.setAttribute('font-size','7px'); t1.setAttribute('font-weight','600');
			  t1.textContent=val; svg.appendChild(t1);
			  var ring=document.createElementNS(ns,'circle'); ring.setAttribute('cx',px); ring.setAttribute('cy',py); ring.setAttribute('r','7'); ring.setAttribute('fill','none'); ring.setAttribute('stroke',color); ring.setAttribute('stroke-width','1.5'); svg.appendChild(ring);
			  var dot=document.createElementNS(ns,'circle'); dot.setAttribute('cx',px); dot.setAttribute('cy',py); dot.setAttribute('r','3'); dot.setAttribute('fill',color); svg.appendChild(dot);
			  var wd=document.createElementNS(ns,'circle'); wd.setAttribute('cx',px); wd.setAttribute('cy',py); wd.setAttribute('r','1'); wd.setAttribute('fill','#fff'); svg.appendChild(wd);
			 }
			 addCallout(bestidx,cBest,'PEAK');
			 if(worstidx!==bestidx) addCallout(worstidx,cWorst,'LOW');
			 for(var i=0;i<pts.length;i++){
			  (function(idx){
			   var hz=document.createElementNS(ns,'circle');
			   hz.setAttribute('cx',pts[idx].x); hz.setAttribute('cy',pts[idx].y); hz.setAttribute('r','14'); hz.setAttribute('fill','transparent'); hz.setAttribute('cursor','pointer');
			   hz.addEventListener('mouseenter',function(){
			    var v=vals[idx];
			    var html=""<div class=ht-val>""+metric.fmt(v)+"" (""+years[idx]+"")</div>"";
			    if(idx>0){
			     var prev=vals[idx-1]; var diff=v-prev; var isUp=diff>=0;
			     var ac=isUp?cBest:cWorst;
			     var pct = prev!==0 ? Math.abs(diff/prev*100).toFixed(1)+'%' : 'n/a';
			     html+=""<div class=ht-row><span style='font-size:10px;font-weight:600;color:""+ac+""'>""+(isUp?'\u25B2':'\u25BC')+' '+pct+""</span><span class=ht-prev>vs ""+years[idx-1]+""</span></div>"";
			    }
			    hoverTip.innerHTML=html; hoverTip.style.opacity='1';
			    var rect=el.getBoundingClientRect(); var sx=rect.width/W, sy=rect.height/H;
			    var tipX=pts[idx].x*sx-45, tipY=pts[idx].y*sy-56;
			    if(tipX<4) tipX=4; if(tipX+100>rect.width) tipX=rect.width-104;
			    hoverTip.style.left=tipX+'px'; hoverTip.style.top=tipY+'px';
			   });
			   hz.addEventListener('mouseleave',function(){ hoverTip.style.opacity='0'; });
			   svg.appendChild(hz);
			  })(i);
			 }
			 el.appendChild(svg);
			 if(active==='def' && maxY && prevY){
			  cautionEl.style.display='flex';
			  cautionEl.innerHTML=""<span style='font-size:13px;'>\u26A0</span><span><b style='color:#A4501A;'>""+prevY+""\u2013""+maxY+"" appear artificially low.</b> Loans issued that recently have not had time to default \u2014 treat the drop as unmatured data, not improving risk.</span>"";
			 }else{
			  cautionEl.style.display='none';
			 }
			}
			buildTabs();
			render();
			window.addEventListener('resize',render);
			})();
			</script>"
			
			VAR _html =
			"<div class='tc'>" & _style &
			"<div class='tc-hdr'>
			<div>
			<div class='tag'><span class='tagtxt'>RISK METRIC</span></div>
			<div class='ttl'>Risk Trend Over Time</div>
			<div class='sub'>Yearly portfolio view</div>
			<div id='summary' class='summary'></div>
			</div>
			<div style='display:flex;flex-direction:column;align-items:flex-end;gap:4px;'>
			<div class='hint'><span class='hinttxt'>Select the view</span></div>
			<div id='tabs' class='tabs'></div>
			<div class='legend'>
			<span class='lgi'><span class='lgbar' style='background:#4A7A3B;'></span><span class='lgtxt'>YoY gain</span></span>
			<span class='lgi'><span class='lgbar' style='background:#A8524B;'></span><span class='lgtxt'>YoY drop</span></span>
			</div>
			</div>
			</div>
			<div class='tc-chart' id='chart'><div id='hoverTip'></div></div>
			<div id='caution' class='caution'></div>
			</div>" & _js
			RETURN _html
		displayFolder: HTML Visuals - Risk
		lineageTag: bfef1e9c-22c5-4c0d-9cbd-1a4b0edf4522

	measure 'Purpose Volume Share %' = DIVIDE([Total Amount], CALCULATE([Total Amount], ALL(dim_purpose[purpose])))
		formatString: 0.0%
		lineageTag: 1ba849db-4f84-4cc2-96be-69d3f7e111e2

	measure 'Purpose Default Rate Tooltip' = FORMAT([AVG Default Rate],"0.0%") & " default rate"
		lineageTag: 35509480-8881-47ca-809c-0525fec3d05c

	measure 'Risk Purpose Share Bars HTML' =
			VAR _purposeTable =
			    ADDCOLUMNS(
			        ALLSELECTED(dim_purpose[purpose]),
			        "__amount", CALCULATE([Total Amount]),
			        "__share", CALCULATE([Purpose Volume Share %]),
			        "__rate", CALCULATE([AVG Default Rate])
			    )
			VAR _maxAmount = MAXX(_purposeTable, [__amount])
			VAR _rows =
			    CONCATENATEX(
			        _purposeTable,
			        VAR _purpose = dim_purpose[purpose]
			        VAR _amount = [__amount]
			        VAR _share = [__share]
			        VAR _rate = [__rate]
			        VAR _barWidth = FORMAT(DIVIDE(_amount, _maxAmount, 0) * 100, "0.0")
			        RETURN
			            "<div class='row'>" &
			                "<div class='top'><span class='purpose'>" & _purpose & "</span>" &
			                "<span class='amount'>" & FORMAT(_amount, "$#,##0.00") & " &middot; " & FORMAT(_share, "0.0%") & "</span></div>" &
			                "<div class='track'><div class='bar' style='width:" & _barWidth & "%'></div></div>" &
			                "<div class='rate'>" & FORMAT(_rate, "0.0%") & " default rate</div>" &
			            "</div>",
			        "",
			        [__amount], DESC
			    )
			RETURN
			    "<div class='wrap'><style>" &
			    "html,body{margin:0;width:100%;height:100%;background:transparent;font-family:Jost,Segoe UI,Arial,sans-serif;color:#3B241B;}" &
			    ".wrap{box-sizing:border-box;width:100%;height:100%;overflow-y:auto;overflow-x:hidden;background:#fff;border:1px solid #EDF0F5;border-radius:10px;padding:18px 20px 12px;}" &
			    ".title{font-size:20px;line-height:1.2;letter-spacing:.04em;font-weight:700;color:#3B241B;margin:0 0 12px;}" &
			    ".row{margin:0 0 15px;}" &
			    ".top{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:0 0 6px;}" &
			    ".purpose{font-size:15px;font-weight:650;color:#3B241B;}" &
			    ".amount{font-size:13px;color:#8a8f9c;white-space:nowrap;text-align:right;}" &
			    ".track{height:14px;border-radius:4px;background:#EDF0F5;overflow:hidden;}" &
			    ".bar{height:100%;border-radius:4px;background:#241411;min-width:3px;}" &
			    ".rate{font-size:13px;color:#8a8f9c;font-weight:600;margin-top:5px;}" &
			    "::-webkit-scrollbar{width:8px}::-webkit-scrollbar-thumb{background:#c9cdd2;border-radius:5px}::-webkit-scrollbar-track{background:transparent}" &
			    "</style><div class='title'>PURPOSE VOLUME</div>" & _rows & "</div>"
		displayFolder: HTML Visuals - Risk
		lineageTag: 47404b59-00e6-4190-a44f-39cdf873582c

	/// Three strong Risk-Analysis KPI cards (Term Risk Gap, Charged-off Dollar Exposure, Credit Quality Gap) — white card style with sparkline + YoY comparison, flips to solid dark on hover to reveal explanation. Grade Risk Spread was dropped: it duplicated the Hero card's grade-risk story thematically even though the number differed.
	measure 'Risk KPI Cards HTML' =
			VAR _yrTbl = SUMMARIZE(dim_date, dim_date[year])
			
			VAR _t36 = CALCULATE([AVG Default Rate], fact_loan[term_months] = 36)
			VAR _t60 = CALCULATE([AVG Default Rate], fact_loan[term_months] = 60)
			VAR _tGapF = FORMAT((_t60 - _t36) * 100, "+0.0;-0.0") & " pts"
			VAR _t36F = FORMAT(_t36, "0.0%")
			VAR _t60F = FORMAT(_t60, "0.0%")
			
			VAR _defTbl = FILTER(ADDCOLUMNS(_yrTbl, "V", [AVG Default Rate]), NOT ISBLANK([V]))
			VAR _defN = COUNTROWS(_defTbl)
			VAR _defMin = MINX(_defTbl,[V])
			VAR _defMax = MAXX(_defTbl,[V])
			VAR _defRange = IF(_defMax=_defMin,1,_defMax-_defMin)
			VAR _defRanked = ADDCOLUMNS(_defTbl, "Idx", RANKX(_defTbl, dim_date[year],,ASC,DENSE))
			VAR _defPts = CONCATENATEX(_defRanked, FORMAT((([Idx]-1)/(_defN-1))*100,"0.0") & "," & FORMAT(26-((([V]-_defMin)/_defRange)*22+2),"0.0"), " ", [Idx], ASC)
			VAR _defFirstYr = MINX(_defTbl, dim_date[year])
			VAR _defLastYr = MAXX(_defTbl, dim_date[year])
			VAR _defPrevYr = _defLastYr - 1
			VAR _defLastV = CALCULATE([AVG Default Rate], dim_date[year] = _defLastYr)
			VAR _defPrevV = CALCULATE([AVG Default Rate], dim_date[year] = _defPrevYr)
			VAR _defFirstV = CALCULATE([AVG Default Rate], dim_date[year] = _defFirstYr)
			VAR _defYoYUp = _defLastV >= _defPrevV
			VAR _defYoYArrow = IF(_defYoYUp,"▲","▼")
			VAR _defYoYColor = IF(_defYoYUp,"#D9432F","#1C9A5B")
			VAR _defYoYPct = FORMAT(ABS(DIVIDE(_defLastV-_defPrevV,_defPrevV))*100,"0.0") & "%"
			VAR _defLongUp = _defLastV >= _defFirstV
			VAR _defLongArrow = IF(_defLongUp,"▲","▼")
			VAR _defLongColor = IF(_defLongUp,"#D9432F","#1C9A5B")
			VAR _defLongPct = FORMAT(ABS(DIVIDE(_defLastV-_defFirstV,_defFirstV))*100,"0.0") & "%"
			
			VAR _badAmt = CALCULATE([Total Amount], dim_loan_status[loan_status] = "Charged Off")
			VAR _badAmtB = FORMAT(DIVIDE(_badAmt,1000000000), "0.00") & "B"
			VAR _badAmtPct = FORMAT(DIVIDE(_badAmt,[Total Amount]), "0.0%")
			
			VAR _amtTbl = FILTER(ADDCOLUMNS(_yrTbl,"V", DIVIDE([Total Amount],1000000000)), NOT ISBLANK([V]))
			VAR _amtN = COUNTROWS(_amtTbl)
			VAR _amtMin = MINX(_amtTbl,[V])
			VAR _amtMax = MAXX(_amtTbl,[V])
			VAR _amtRange = IF(_amtMax=_amtMin,1,_amtMax-_amtMin)
			VAR _amtRanked = ADDCOLUMNS(_amtTbl,"Idx", RANKX(_amtTbl, dim_date[year],,ASC,DENSE))
			VAR _amtPts = CONCATENATEX(_amtRanked, FORMAT((([Idx]-1)/(_amtN-1))*100,"0.0") & "," & FORMAT(26-((([V]-_amtMin)/_amtRange)*22+2),"0.0"), " ", [Idx], ASC)
			VAR _amtFirstYr = MINX(_amtTbl, dim_date[year])
			VAR _amtLastYr = MAXX(_amtTbl, dim_date[year])
			VAR _amtPrevYr = _amtLastYr - 1
			VAR _amtLastV = CALCULATE(DIVIDE([Total Amount],1000000000), dim_date[year] = _amtLastYr)
			VAR _amtPrevV = CALCULATE(DIVIDE([Total Amount],1000000000), dim_date[year] = _amtPrevYr)
			VAR _amtFirstV = CALCULATE(DIVIDE([Total Amount],1000000000), dim_date[year] = _amtFirstYr)
			VAR _amtYoYUp = _amtLastV >= _amtPrevV
			VAR _amtYoYArrow = IF(_amtYoYUp,"▲","▼")
			VAR _amtYoYPct = FORMAT(ABS(DIVIDE(_amtLastV-_amtPrevV,_amtPrevV))*100,"0.0") & "%"
			VAR _amtLongUp = _amtLastV >= _amtFirstV
			VAR _amtLongArrow = IF(_amtLongUp,"▲","▼")
			VAR _amtLongPct = FORMAT(ABS(DIVIDE(_amtLastV-_amtFirstV,_amtFirstV))*100,"0.0") & "%"
			VAR _amtColor = "#8a8f9c"
			
			VAR _ficoBad = CALCULATE([Avg FICO Score], dim_loan_status[loan_status] = "Charged Off")
			VAR _ficoGood = CALCULATE([Avg FICO Score], dim_loan_status[loan_status] = "Fully Paid")
			VAR _ficoBadF = FORMAT(_ficoBad, "0")
			VAR _ficoGoodF = FORMAT(_ficoGood, "0")
			VAR _ficoGapF = FORMAT(_ficoGood - _ficoBad, "0") & " pts"
			
			VAR _ficoTbl = FILTER(ADDCOLUMNS(_yrTbl,"V",[Avg FICO Score]), NOT ISBLANK([V]))
			VAR _ficoN = COUNTROWS(_ficoTbl)
			VAR _ficoMin = MINX(_ficoTbl,[V])
			VAR _ficoMax = MAXX(_ficoTbl,[V])
			VAR _ficoRange = IF(_ficoMax=_ficoMin,1,_ficoMax-_ficoMin)
			VAR _ficoRanked = ADDCOLUMNS(_ficoTbl,"Idx",RANKX(_ficoTbl,dim_date[year],,ASC,DENSE))
			VAR _ficoPts = CONCATENATEX(_ficoRanked, FORMAT((([Idx]-1)/(_ficoN-1))*100,"0.0") & "," & FORMAT(26-((([V]-_ficoMin)/_ficoRange)*22+2),"0.0"), " ", [Idx], ASC)
			VAR _ficoFirstYr = MINX(_ficoTbl,dim_date[year])
			VAR _ficoLastYr = MAXX(_ficoTbl,dim_date[year])
			VAR _ficoPrevYr = _ficoLastYr - 1
			VAR _ficoLastV = CALCULATE([Avg FICO Score], dim_date[year]=_ficoLastYr)
			VAR _ficoPrevV = CALCULATE([Avg FICO Score], dim_date[year]=_ficoPrevYr)
			VAR _ficoFirstV = CALCULATE([Avg FICO Score], dim_date[year]=_ficoFirstYr)
			VAR _ficoYoYUp = _ficoLastV >= _ficoPrevV
			VAR _ficoYoYArrow = IF(_ficoYoYUp,"▲","▼")
			VAR _ficoYoYColor = IF(_ficoYoYUp,"#1C9A5B","#D9432F")
			VAR _ficoYoYPct = FORMAT(ABS(DIVIDE(_ficoLastV-_ficoPrevV,_ficoPrevV))*100,"0.0") & "%"
			VAR _ficoLongUp = _ficoLastV >= _ficoFirstV
			VAR _ficoLongArrow = IF(_ficoLongUp,"▲","▼")
			VAR _ficoLongColor = IF(_ficoLongUp,"#1C9A5B","#D9432F")
			VAR _ficoLongPct = FORMAT(ABS(DIVIDE(_ficoLastV-_ficoFirstV,_ficoFirstV))*100,"0.0") & "%"
			
			VAR _css = "<style>html,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden;background:transparent!important}*{box-sizing:border-box}.rk{font-family:Jost,'Segoe UI',sans-serif;width:100%;height:100%;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.c{position:relative;overflow:hidden;border-radius:14px;background:#fff;border:1px solid #EDF0F5;box-shadow:0 1px 3px rgba(16,24,40,.06);transition:box-shadow .2s ease}.c:hover{box-shadow:0 6px 18px rgba(16,24,40,.14)}.front{position:relative;z-index:1;padding:16px 18px;height:100%;box-sizing:border-box;display:flex;flex-direction:column}.q{position:absolute;top:14px;right:14px;width:16px;height:16px;border-radius:50%;border:1px solid #cfd4de;color:#9aa1b1;font-size:9.5px;font-weight:600;display:flex;align-items:center;justify-content:center}.lbl{font-size:10.5px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:#6b7280}.val{font-family:'Cormorant Garamond',Georgia,serif;font-size:30px;font-weight:700;color:#1f2430;margin-top:6px;line-height:1}.cmp{font-size:10.5px;color:#8a8f9c;margin-top:7px;line-height:1.5}.cmp b{color:#1f2430;font-weight:600}.spark{margin-top:auto;padding-top:8px;width:100%;height:26px}.back{position:absolute;inset:0;z-index:2;background:#181513;padding:18px;display:flex;flex-direction:column;justify-content:center;opacity:0;transform:translateY(4px);transition:.22s ease;pointer-events:none}.c:hover .back{opacity:1;transform:none;pointer-events:auto}.backl{font-size:9.5px;letter-spacing:1.2px;text-transform:uppercase;color:#D9432F;font-weight:700}.backp{font-size:12px;line-height:1.6;color:#f0ece7;margin-top:8px}@media(max-width:700px){.rk{gap:8px}.front{padding:12px}.val{font-size:24px}.cmp{font-size:9.5px}}</style>"
			
			RETURN _css & "<div class='rk'>" &
			
			"<div class='c'><div class='front'><span class='q'>?</span><div class='lbl'>Term Risk Gap</div><div class='val'>" & _tGapF & "</div><div class='cmp'>" & _defLastYr & ": <b>" & FORMAT(_defLastV,"0.0%") & "</b> <span style='color:" & _defYoYColor & "'>" & _defYoYArrow & " " & _defYoYPct & "</span></div><div class='cmp'>Since " & _defFirstYr & ": <span style='color:" & _defLongColor & "'>" & _defLongArrow & " " & _defLongPct & "</span></div><svg class='spark' viewBox='0 0 100 26' preserveAspectRatio='none'><polyline points='" & _defPts & "' fill='none' stroke='#D9432F' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></svg></div><div class='back'><div class='backl'>Term breakdown</div><div class='backp'>60-month loans default at " & _t60F & ", versus " & _t36F & " for 36-month loans. Longer terms carry materially more risk per dollar lent.</div></div></div>" &
			
			"<div class='c'><div class='front'><span class='q'>?</span><div class='lbl'>Charged-off Exposure</div><div class='val'>$" & _badAmtB & "</div><div class='cmp'>" & _amtLastYr & ": <b>$" & FORMAT(_amtLastV,"0.0") & "B</b> <span style='color:" & _amtColor & "'>" & _amtYoYArrow & " " & _amtYoYPct & "</span></div><div class='cmp'>Since " & _amtFirstYr & ": <span style='color:" & _amtColor & "'>" & _amtLongArrow & " " & _amtLongPct & "</span></div><svg class='spark' viewBox='0 0 100 26' preserveAspectRatio='none'><polyline points='" & _amtPts & "' fill='none' stroke='#8a8f9c' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></svg></div><div class='back'><div class='backl'>Dollar exposure</div><div class='backp'>$" & _badAmtB & " in loan principal is tied to charged-off or defaulted loans — " & _badAmtPct & " of total originated volume.</div></div></div>" &
			
			"<div class='c'><div class='front'><span class='q'>?</span><div class='lbl'>Credit Quality Gap</div><div class='val'>" & _ficoGapF & "</div><div class='cmp'>" & _ficoLastYr & ": <b>" & FORMAT(_ficoLastV,"0") & "</b> <span style='color:" & _ficoYoYColor & "'>" & _ficoYoYArrow & " " & _ficoYoYPct & "</span></div><div class='cmp'>Since " & _ficoFirstYr & ": <span style='color:" & _ficoLongColor & "'>" & _ficoLongArrow & " " & _ficoLongPct & "</span></div><svg class='spark' viewBox='0 0 100 26' preserveAspectRatio='none'><polyline points='" & _ficoPts & "' fill='none' stroke='#1C9A5B' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></svg></div><div class='back'><div class='backl'>Score gap</div><div class='backp'>Fully paid borrowers average " & _ficoGoodF & " FICO, versus " & _ficoBadF & " for charged-off borrowers. FICO alone doesn’t fully separate outcomes — grade and term matter too.</div></div></div>" &
			
			"</div>"
		displayFolder: HTML Visuals - Risk
		lineageTag: 8d4d4bd8-038b-419a-9e0b-650253925feb

	measure 'Top 10 State Loan Amount' =
			VAR _rank = RANKX(ALL(dim_geography[borrower_state]), CALCULATE([Total Amount]),,DESC,DENSE)
			RETURN IF(_rank <= 10, [Total Amount])
		displayFolder: Borrower Profile
		lineageTag: 12da14af-8cb9-40c1-9f3c-e80e984e6b1f

	/// Two Borrower Profile KPI cards (Avg Annual Income, Avg DTI) — right-side sparkline layout. Quarterly sparklines (28-36 points) for wavy lines. Fixed: dim_date[quarter] is String type so sort key now uses VALUE(RIGHT(quarter,1)) instead of integer arithmetic.
	measure 'Borrower KPI Cards HTML' =
			-- Sort key: year*10 + quarter number extracted from string (handles Q1/Q2/Q3/Q4)
			VAR _qBase = ADDCOLUMNS(
			    SUMMARIZE(dim_date, dim_date[year], dim_date[quarter]),
			    "sk", dim_date[year] * 10 + VALUE(RIGHT(dim_date[quarter], 1))
			)
			
			-- ============ INCOME SPARKLINE (quarterly) ============
			VAR _iqRaw = FILTER(ADDCOLUMNS(_qBase, "v", [AVG Annual Income]), NOT ISBLANK([v]))
			VAR _iqRk  = ADDCOLUMNS(_iqRaw, "r", RANKX(_iqRaw, [sk],, ASC, DENSE))
			VAR _iqN   = COUNTROWS(_iqRk)
			VAR _iqMin = MINX(_iqRk, [v])
			VAR _iqMax = MAXX(_iqRk, [v])
			VAR _iqRng = IF(_iqMax = _iqMin, 1, _iqMax - _iqMin)
			VAR _iqPts = CONCATENATEX(
			    _iqRk,
			    FORMAT(([r]-1)/(_iqN-1)*100, "0.0") & "," &
			    FORMAT(58 - (([v]-_iqMin)/_iqRng)*52, "0.0"),
			    " ", [r], ASC)
			VAR _iqLastRaw = MAXX(FILTER(_iqRk, [r] = _iqN), [v])
			VAR _iqLastY   = FORMAT(58 - ((_iqLastRaw - _iqMin)/_iqRng)*52, "0.0")
			
			-- ============ INCOME CHIPS (yearly) ============
			VAR _yTbl    = SUMMARIZE(dim_date, dim_date[year])
			VAR _iYTbl   = FILTER(ADDCOLUMNS(_yTbl, "v", [AVG Annual Income]), NOT ISBLANK([v]))
			VAR _iLastYr = MAXX(_iYTbl, dim_date[year])
			VAR _iFirstYr= MINX(_iYTbl, dim_date[year])
			VAR _iLastV  = CALCULATE([AVG Annual Income], dim_date[year] = _iLastYr)
			VAR _iPrevV  = CALCULATE([AVG Annual Income], dim_date[year] = _iLastYr - 1)
			VAR _iFirstV = CALCULATE([AVG Annual Income], dim_date[year] = _iFirstYr)
			VAR _iYoYUp  = _iLastV >= _iPrevV
			VAR _iYoYClr = IF(_iYoYUp, "#1C9A5B", "#D9432F")
			VAR _iYoYTxt = FORMAT(ABS(DIVIDE(_iLastV-_iPrevV,_iPrevV))*100,"0.0") & "%"
			VAR _iYoYArr = IF(_iYoYUp, "▲", "▼")
			VAR _iLongUp = _iLastV >= _iFirstV
			VAR _iLongClr= IF(_iLongUp, "#1C9A5B", "#D9432F")
			VAR _iLongTxt= FORMAT(ABS(DIVIDE(_iLastV-_iFirstV,_iFirstV))*100,"0.0") & "%"
			VAR _iLongArr= IF(_iLongUp, "▲", "▼")
			VAR _incTxt  = "$" & FORMAT([AVG Annual Income],"#,##0")
			VAR _bestGrade  = MAXX(TOPN(1,VALUES(dim_grade[grade]),[AVG Annual Income],DESC),dim_grade[grade])
			VAR _worstGrade = MAXX(TOPN(1,VALUES(dim_grade[grade]),[AVG Annual Income],ASC), dim_grade[grade])
			VAR _incGapTxt  = "$" & FORMAT(
			    CALCULATE([AVG Annual Income],dim_grade[grade]=_bestGrade) -
			    CALCULATE([AVG Annual Income],dim_grade[grade]=_worstGrade),"#,##0")
			
			-- ============ DTI SPARKLINE (quarterly) ============
			VAR _dqRaw = FILTER(ADDCOLUMNS(_qBase, "v", [AVG DTI]), NOT ISBLANK([v]))
			VAR _dqRk  = ADDCOLUMNS(_dqRaw, "r", RANKX(_dqRaw, [sk],, ASC, DENSE))
			VAR _dqN   = COUNTROWS(_dqRk)
			VAR _dqMin = MINX(_dqRk, [v])
			VAR _dqMax = MAXX(_dqRk, [v])
			VAR _dqRng = IF(_dqMax = _dqMin, 1, _dqMax - _dqMin)
			VAR _dqPts = CONCATENATEX(
			    _dqRk,
			    FORMAT(([r]-1)/(_dqN-1)*100, "0.0") & "," &
			    FORMAT(58 - (([v]-_dqMin)/_dqRng)*52, "0.0"),
			    " ", [r], ASC)
			VAR _dqLastRaw = MAXX(FILTER(_dqRk, [r] = _dqN), [v])
			VAR _dqLastY   = FORMAT(58 - ((_dqLastRaw - _dqMin)/_dqRng)*52, "0.0")
			
			-- ============ DTI CHIPS (yearly) ============
			VAR _dYTbl   = FILTER(ADDCOLUMNS(_yTbl, "v", [AVG DTI]), NOT ISBLANK([v]))
			VAR _dLastYr = MAXX(_dYTbl, dim_date[year])
			VAR _dFirstYr= MINX(_dYTbl, dim_date[year])
			VAR _dLastV  = CALCULATE([AVG DTI], dim_date[year] = _dLastYr)
			VAR _dPrevV  = CALCULATE([AVG DTI], dim_date[year] = _dLastYr - 1)
			VAR _dFirstV = CALCULATE([AVG DTI], dim_date[year] = _dFirstYr)
			VAR _dYoYUp  = _dLastV >= _dPrevV
			VAR _dYoYClr = IF(_dYoYUp, "#D9432F", "#1C9A5B")
			VAR _dYoYTxt = FORMAT(ABS(DIVIDE(_dLastV-_dPrevV,_dPrevV))*100,"0.0") & "%"
			VAR _dYoYArr = IF(_dYoYUp, "▲", "▼")
			VAR _dLongUp = _dLastV >= _dFirstV
			VAR _dLongClr= IF(_dLongUp, "#D9432F", "#1C9A5B")
			VAR _dLongTxt= FORMAT(ABS(DIVIDE(_dLastV-_dFirstV,_dFirstV))*100,"0.0") & "%"
			VAR _dLongArr= IF(_dLongUp, "▲", "▼")
			VAR _dtiTxt  = FORMAT([AVG DTI],"0.0") & "%"
			VAR _highDti = FORMAT(DIVIDE(CALCULATE(COUNTROWS(fact_loan),fact_loan[win_dti]>36),COUNTROWS(fact_loan)),"0.0%")
			
			-- ============ CSS ============
			VAR _css = "<style>html,body{margin:0;padding:0;width:100%;height:100vh;overflow:hidden;background:transparent!important}*{box-sizing:border-box}.bk{font-family:Jost,'Segoe UI',sans-serif;width:100%;height:100vh;min-height:100vh;display:grid;grid-template-columns:1fr 1fr;gap:16px;padding:1px}.c{position:relative;overflow:hidden;height:100%;min-height:0;border-radius:14px;background:#fff;border:1px solid #E4EAEE;box-shadow:0 4px 14px rgba(16,24,40,.10);transition:box-shadow .2s ease,transform .2s ease;display:flex;flex-direction:row;align-items:stretch}.c:hover{box-shadow:0 12px 28px rgba(16,24,40,.16);transform:translateY(-2px)}.cl{flex:1;padding:22px 10px 22px 22px;display:flex;flex-direction:column;justify-content:center;min-width:0;position:relative;z-index:1}.cr{width:118px;flex-shrink:0;padding:20px 18px 20px 4px;display:flex;align-items:stretch;position:relative;z-index:1}.ic{position:absolute;top:12px;right:12px;width:22px;height:22px;border-radius:50%;background:#EEF3F5;color:#52636D;font-family:Georgia,serif;font-style:italic;font-weight:700;font-size:12px;display:flex;align-items:center;justify-content:center;z-index:3}.lbl{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#65717F}.val{font-family:'Cormorant Garamond',Georgia,serif;font-size:39px;font-weight:700;color:#17212B;margin-top:7px;line-height:1;white-space:nowrap}.chips{display:flex;flex-direction:column;gap:7px;margin-top:13px}.chip{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:999px;font-weight:700;font-size:10.5px;width:fit-content}.spark{width:100%;height:100%;overflow:visible}.dot{filter:drop-shadow(0 0 2px rgba(0,0,0,.25))}.back{position:absolute;inset:0;z-index:2;background:linear-gradient(155deg,#132623,#0d1b19);padding:24px 25px;display:flex;flex-direction:column;justify-content:center;opacity:0;transform:translateY(5px);transition:.22s ease;pointer-events:none}.c:hover .back{opacity:1;transform:none;pointer-events:auto}.backl{font-size:10.5px;letter-spacing:1.2px;text-transform:uppercase;color:#70C7BD;font-weight:700}.backp{font-size:13px;line-height:1.6;color:#e3f0ef;margin-top:10px}</style>"
			
			-- ============ HTML ============
			RETURN _css &
			"<div style='position:relative;overflow:hidden;height:100vh;width:100%;border-radius:14px'><div class='bk'>" &
			
			"<div class='c'><div class='cl'><div class='lbl'>Avg Annual Income</div><div class='val'>" & _incTxt & "</div><div class='chips'><span class='chip' style='background:" & _iYoYClr & "18;color:" & _iYoYClr & "'>" & _iYoYArr & " " & _iYoYTxt & " YoY</span><span class='chip' style='background:" & _iLongClr & "18;color:" & _iLongClr & "'>" & _iLongArr & " " & _iLongTxt & " since " & _iFirstYr & "</span></div></div><div class='cr'><svg class='spark' viewBox='0 0 100 64' preserveAspectRatio='none'><polyline points='" & _iqPts & "' fill='none' stroke='#1B6B6B' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/><circle class='dot' cx='100' cy='" & _iqLastY & "' r='3.2' fill='#E8A33D' stroke='#fff' stroke-width='1.5'/></svg></div><span class='ic'>i</span><div class='back'><div class='backl'>Income gap · Grade " & _bestGrade & " vs " & _worstGrade & "</div><div class='backp'>Grade " & _bestGrade & " borrowers earn " & _incGapTxt & " more per year than Grade " & _worstGrade & " — across the current selection.</div></div></div>" &
			
			"<div class='c'><div class='cl'><div class='lbl'>Avg DTI</div><div class='val'>" & _dtiTxt & "</div><div class='chips'><span class='chip' style='background:" & _dYoYClr & "18;color:" & _dYoYClr & "'>" & _dYoYArr & " " & _dYoYTxt & " YoY</span><span class='chip' style='background:" & _dLongClr & "18;color:" & _dLongClr & "'>" & _dLongArr & " " & _dLongTxt & " since " & _dFirstYr & "</span></div></div><div class='cr'><svg class='spark' viewBox='0 0 100 64' preserveAspectRatio='none'><polyline points='" & _dqPts & "' fill='none' stroke='#D9432F' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/><circle class='dot' cx='100' cy='" & _dqLastY & "' r='3.2' fill='#E8A33D' stroke='#fff' stroke-width='1.5'/></svg></div><span class='ic'>i</span><div class='back'><div class='backl'>High-DTI share</div><div class='backp'>" & _highDti & " of borrowers carry a DTI above 36% — a common affordability-risk threshold.</div></div></div>" &
			
			"</div></div>"
		displayFolder: HTML Visuals
		lineageTag: 6f524d24-1be3-4ecf-975a-0130a9be738a

	/// Borrower Profile hero card (HTML Content visual): flat-lay wallet/card photo with teal gradient overlay, headline, Avg Credit Age as big stat, hover-reveal panel showing avg total accounts and avg revolving utilization (fields unused elsewhere on the page).
	measure 'Borrower Hero HTML' =
			VAR _CreditAge = [Avg Credit Age (Years)]
			VAR _CreditAgeTxt = FORMAT(_CreditAge, "0.0")
			VAR _Accounts = AVERAGE(fact_loan[total_accounts])
			VAR _AccountsTxt = FORMAT(_Accounts, "0.0")
			VAR _Open = AVERAGE(fact_loan[open_accounts])
			VAR _OpenTxt = FORMAT(_Open, "0.0")
			VAR _Util = AVERAGE(fact_loan[revolving_utilization_rate])
			VAR _UtilTxt = FORMAT(_Util, "0.0") & "%"
			VAR _img = "https://i.ibb.co/PstrTKDv/pexels-cottonbro-3944405.jpg"
			VAR _html =
			"<div style='font-family:Jost,Segoe UI,system-ui,sans-serif;position:relative;overflow:hidden;height:100vh;width:100%;border-radius:14px;cursor:pointer;'>
			<style>
			  html,body{ overflow:hidden!important; margin:0; padding:0; height:100vh; width:100%; background:transparent!important }
			  @keyframes imgIn{ 0%{opacity:0} 100%{opacity:1} }
			  @keyframes imgDrift{ 0%{transform:scale(1.04) translateX(0)} 100%{transform:scale(1.04) translateX(-2%)} }
			  .bg-img{ position:absolute; top:0; left:0; width:106%; height:100%; object-fit:cover; object-position:50% 35%; opacity:0; animation:imgIn 1.2s ease .2s forwards, imgDrift 26s ease-in-out 1s infinite alternate; }
			  .ve-wrap{ position:relative; width:100%; height:100%; overflow:hidden; border-radius:14px; }
			  .face{ position:relative; height:100%; width:100%; box-sizing:border-box; }
			  .overlay{ position:absolute; top:0; left:0; width:100%; height:100%; background:linear-gradient(155deg,rgba(36,20,17,.55) 0%,rgba(30,16,14,.72) 45%,rgba(18,9,8,.9) 100%); }
			  .content{ position:relative; z-index:1; padding:20px 22px; display:flex; flex-direction:column; justify-content:center; height:100%; box-sizing:border-box; gap:6px; }
			  .tag{ display:inline-flex; align-items:center; gap:7px; background:rgba(255,255,255,.14); padding:4px 11px; border-radius:999px; width:fit-content; }
			  .dot{ width:6px; height:6px; border-radius:50%; background:#D9432F; }
			  .tagtxt{ font-size:10.5px; font-weight:600; letter-spacing:1.5px; color:#f0a99e; }
			  .ttl{ font-family:Cormorant Garamond,Georgia,serif; font-size:25px; font-weight:700; color:#ffffff; line-height:1.08; text-shadow:0 1px 4px rgba(0,0,0,.4); margin-top:6px; }
			  .subline{ font-size:12.5px; font-weight:400; color:#e6d3cc; margin-top:3px; }
			  .num{ font-family:Cormorant Garamond,Georgia,serif; font-size:44px; font-weight:700; color:#ffffff; line-height:1; text-shadow:0 2px 6px rgba(0,0,0,.45); margin-top:6px; }
			  .para{ font-size:12px; font-weight:300; color:#e6d8d2; line-height:1.5; margin-top:6px; max-width:96%; }
			  .hint{ font-size:10.5px; color:#c9beb5; margin-top:8px; opacity:.85; }
			  .panel{ position:absolute; inset:0; background:linear-gradient(155deg,#1e1613,#2a1a17); color:#fff; padding:20px 22px; display:flex; flex-direction:column; justify-content:center; gap:9px; opacity:0; transition:opacity .35s ease; pointer-events:none; z-index:2; box-sizing:border-box; }
			  .ve-wrap:hover .panel{ opacity:1; pointer-events:auto; }
			  .ptitle{ font-size:10.5px; font-weight:700; letter-spacing:1.2px; color:#f0a99e; text-transform:uppercase; }
			  .row{ display:flex; align-items:baseline; gap:10px; border-top:1px solid rgba(255,255,255,.12); padding-top:8px; }
			  .rv{ font-size:18px; font-weight:700; color:#f0a99e; min-width:52px; font-family:Cormorant Garamond,Georgia,serif; }
			  .rl{ font-size:12px; color:#d8ccc3; line-height:1.3; }
			  .safe{ font-size:11.5px; color:#9fc9ad; margin-top:4px; }
			</style>
			<div class='ve-wrap'>
			  <div class='face'>
			    <img class='bg-img' src='" & _img & "' />
			    <div class='overlay'></div>
			    <div class='content'>
			      <div class='tag'><span class='dot'></span><span class='tagtxt'>BORROWER PROFILE</span></div>
			      <div class='ttl'>Who&#39;s Borrowing</div>
			      <div class='subline'>Average credit history across the book</div>
			      <div class='num'>" & _CreditAgeTxt & " yrs</div>
			      <div class='para'>That&#39;s the average age of a borrower&#39;s credit file at the time of the loan &mdash; more years on file generally means more data for underwriting, but individual grade and income still vary widely around that average.</div>
			      <div class='hint'>Hover for account depth</div>
			    </div>
			  </div>
			  <div class='panel'>
			    <div class='ptitle'>Account depth</div>
			    <div class='row'><div class='rv'>" & _AccountsTxt & "</div><div class='rl'>average total accounts on file per borrower</div></div>
			    <div class='row'><div class='rv'>" & _OpenTxt & "</div><div class='rl'>average currently open accounts</div></div>
			    <div class='row'><div class='rv'>" & _UtilTxt & "</div><div class='rl'>average revolving utilization across the book</div></div>
			    <div class='safe'>More open accounts alongside higher utilization signal thinner breathing room, even at the same credit age.</div>
			  </div>
			</div>
			</div>"
			RETURN _html
		displayFolder: HTML Visuals
		lineageTag: f686ab86-de8c-4d81-9b7a-f723e064c608

	measure 'Borrower Risk Factors HTML' =
			VAR _employmentBase = FILTER(ALLSELECTED(dim_borrower[employment_length]), NOT ISBLANK(dim_borrower[employment_length]))
			VAR _homeBase = FILTER(ALLSELECTED(dim_borrower[home_ownership]), NOT ISBLANK(dim_borrower[home_ownership]))
			VAR _employment = ADDCOLUMNS(_employmentBase, "__rate", CALCULATE([AVG Default Rate]), "__loans", CALCULATE([Total Loan]))
			VAR _home = ADDCOLUMNS(_homeBase, "__rate", CALCULATE([AVG Default Rate]), "__loans", CALCULATE([Total Loan]))
			VAR _maxEmployment = MAXX(_employment, [__rate])
			VAR _maxHome = MAXX(_home, [__rate])
			VAR _employmentRows =
				CONCATENATEX(
					_employment,
					VAR _category = dim_borrower[employment_length]
					VAR _rate = [__rate]
					VAR _loans = [__loans]
					VAR _width = FORMAT(100 * DIVIDE(_rate, _maxEmployment, 0), "0.0")
					RETURN "<div class='rf-row' title='" & _category & " · " & FORMAT(_loans, "#,##0") & " loans · " & FORMAT(_rate, "0.0%") & " default rate'><span class='rf-label'>" & _category & "</span><span class='rf-track'><span class='rf-fill' style='width:" & _width & "%'></span></span><span class='rf-rate'>" & FORMAT(_rate, "0.0%") & "</span></div>",
					"",
					[__rate], DESC
				)
			VAR _homeRows =
				CONCATENATEX(
					_home,
					VAR _category = dim_borrower[home_ownership]
					VAR _rate = [__rate]
					VAR _loans = [__loans]
					VAR _width = FORMAT(100 * DIVIDE(_rate, _maxHome, 0), "0.0")
					RETURN "<div class='rf-row' title='" & _category & " · " & FORMAT(_loans, "#,##0") & " loans · " & FORMAT(_rate, "0.0%") & " default rate'><span class='rf-label'>" & _category & "</span><span class='rf-track'><span class='rf-fill' style='width:" & _width & "%'></span></span><span class='rf-rate'>" & FORMAT(_rate, "0.0%") & "</span></div>",
					"",
					[__rate], DESC
				)
			RETURN
				"<div class='rf-wrap'><style>.rf-wrap{font-family:Segoe UI,Arial,sans-serif;width:100%;height:100vh;box-sizing:border-box;background:#fff;border:1px solid #E5E8E8;border-radius:14px;padding:17px 22px;color:#2B2E2E}.rf-title{font-size:15px;font-weight:700;letter-spacing:.5px;color:#1B6B6B}.rf-sub{font-size:11px;color:#718080;margin-top:4px;margin-bottom:13px}.rf-cols{display:grid;grid-template-columns:1fr 1fr;gap:28px}.rf-section-title{font-size:11px;font-weight:700;color:#334D4D;margin-bottom:7px}.rf-section-title span{font-size:10px;font-weight:400;color:#879595;margin-left:5px}.rf-row{display:grid;grid-template-columns:135px 1fr 48px;align-items:center;gap:10px;height:18px;border-bottom:1px solid #F0F3F3;padding:0 3px;transition:background .16s ease}.rf-row:hover{background:#F3F7F7}.rf-label{font-size:10px;color:#506565;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rf-track{display:block;height:7px;background:#EDF2F2;border-radius:8px;overflow:hidden}.rf-fill{display:block;height:100%;border-radius:8px;background:#1B6B6B;transition:width .3s ease}.rf-row:hover .rf-fill{background:#5C9A9A}.rf-rate{font-size:10px;color:#445B5B;text-align:right;font-weight:600}</style><div class='rf-title'>BORROWER RISK FACTORS</div><div class='rf-sub'>Default rate and loan volume by borrower characteristic · hover a category for loan count</div><div class='rf-cols'><div><div class='rf-section-title'>Employment length <span>sorted highest risk first</span></div>" & _employmentRows & "</div><div><div class='rf-section-title'>Home ownership <span>sorted highest risk first</span></div>" & _homeRows & "</div></div></div>"
		displayFolder: HTML Visuals
		lineageTag: 26a4e651-f4a6-49aa-b603-c9ff80990439

	measure 'Verification Status HTML' =
			VAR _verified = CALCULATE([Total Loan], KEEPFILTERS(dim_borrower[verification_status] = "Verified"))
			VAR _source = CALCULATE([Total Loan], KEEPFILTERS(dim_borrower[verification_status] = "Source Verified"))
			VAR _not = CALCULATE([Total Loan], KEEPFILTERS(dim_borrower[verification_status] = "Not Verified"))
			VAR _total = _verified + _source + _not
			VAR _pV = DIVIDE(_verified,_total,0)
			VAR _pS = DIVIDE(_source,_total,0)
			VAR _pN = DIVIDE(_not,_total,0)
			VAR _rateV = CALCULATE([AVG Default Rate], KEEPFILTERS(dim_borrower[verification_status] = "Verified"))
			VAR _rateS = CALCULATE([AVG Default Rate], KEEPFILTERS(dim_borrower[verification_status] = "Source Verified"))
			VAR _rateN = CALCULATE([AVG Default Rate], KEEPFILTERS(dim_borrower[verification_status] = "Not Verified"))
			RETURN
			"<div style='font-family:Segoe UI,Arial,sans-serif;width:100%;height:100vh;box-sizing:border-box;padding:18px 20px;background:#FFFFFF;border-radius:14px;'><style>.vs-seg{height:18px;transition:opacity .2s ease}.vs-seg:hover{opacity:.75}.vs-row{display:grid;grid-template-columns:10px 1fr auto;align-items:center;gap:9px;padding:9px 0;border-bottom:1px solid #EEF1F1}.vs-dot{height:9px;width:9px;border-radius:50%}.vs-name{font-size:12px;color:#2B2E2E;font-weight:600}.vs-meta{font-size:11px;color:#5C7373;text-align:right}.vs-rate{font-size:10px;color:#5C7373;font-weight:400}</style><div style='font-size:12px;color:#1B6B6B;font-weight:700;letter-spacing:.8px;text-transform:uppercase;margin-bottom:14px'>Verification Status</div><div style='display:flex;overflow:hidden;border-radius:99px;height:18px;margin-bottom:14px'><div class='vs-seg' title='Verified: " & FORMAT(_verified,"#,##0") & " loans · " & FORMAT(_pV,"0.0%") & "' style='width:" & FORMAT(_pV*100,"0.0") & "%;background:#1B6B6B'></div><div class='vs-seg' title='Source Verified: " & FORMAT(_source,"#,##0") & " loans · " & FORMAT(_pS,"0.0%") & "' style='width:" & FORMAT(_pS*100,"0.0") & "%;background:#5C9A9A'></div><div class='vs-seg' title='Not Verified: " & FORMAT(_not,"#,##0") & " loans · " & FORMAT(_pN,"0.0%") & "' style='width:" & FORMAT(_pN*100,"0.0") & "%;background:#C7D9D9'></div></div><div class='vs-row'><span class='vs-dot' style='background:#1B6B6B'></span><div><div class='vs-name'>Verified</div><div class='vs-rate'>Default rate " & FORMAT(_rateV,"0.0%") & "</div></div><div class='vs-meta'>" & FORMAT(_verified,"#,##0") & " · " & FORMAT(_pV,"0.0%") & "</div></div><div class='vs-row'><span class='vs-dot' style='background:#5C9A9A'></span><div><div class='vs-name'>Source Verified</div><div class='vs-rate'>Default rate " & FORMAT(_rateS,"0.0%") & "</div></div><div class='vs-meta'>" & FORMAT(_source,"#,##0") & " · " & FORMAT(_pS,"0.0%") & "</div></div><div class='vs-row' style='border-bottom:0'><span class='vs-dot' style='background:#C7D9D9'></span><div><div class='vs-name'>Not Verified</div><div class='vs-rate'>Default rate " & FORMAT(_rateN,"0.0%") & "</div></div><div class='vs-meta'>" & FORMAT(_not,"#,##0") & " · " & FORMAT(_pN,"0.0%") & "</div></div></div>"
		displayFolder: HTML Visuals
		lineageTag: e7156774-8ee1-4f59-9fee-8ab0fd8c1522

	/// KPI hover card: Avg Annual Income (front) / income gap between best and worst grade (hover reveal).
	measure 'KPI Income HTML' =
			VAR _avg = [AVG Annual Income]
			VAR _avgTxt = "$" & FORMAT(_avg, "#,##0")
			VAR _bestGradeT = TOPN(1, VALUES(dim_grade[grade]), [AVG Annual Income], DESC)
			VAR _bestGrade = MAXX(_bestGradeT, dim_grade[grade])
			VAR _bestVal = CALCULATE([AVG Annual Income], dim_grade[grade] = _bestGrade)
			VAR _worstGradeT = TOPN(1, VALUES(dim_grade[grade]), [AVG Annual Income], ASC)
			VAR _worstGrade = MAXX(_worstGradeT, dim_grade[grade])
			VAR _worstVal = CALCULATE([AVG Annual Income], dim_grade[grade] = _worstGrade)
			VAR _gapTxt = "$" & FORMAT(_bestVal - _worstVal, "#,##0")
			VAR _html =
			"<div style='font-family:Jost,Segoe UI,system-ui,sans-serif;position:relative;overflow:hidden;height:100vh;width:100%;border-radius:10px;cursor:pointer;'>
			<style>
			  html,body{ overflow:hidden!important; margin:0; padding:0; height:100vh; width:100%; background:transparent!important }
			  .kpi-wrap{ position:relative; width:100%; height:100%; overflow:hidden; border-radius:10px; background:linear-gradient(155deg,#241411,#1e130f); }
			  .kpi-face{ position:absolute; inset:0; padding:16px 18px; display:flex; flex-direction:column; justify-content:center; box-sizing:border-box; transition:opacity .35s ease, transform .35s ease; }
			  .kpi-front{ opacity:1; transform:translateY(0); }
			  .kpi-back{ opacity:0; transform:translateY(8px); pointer-events:none; }
			  .kpi-wrap:hover .kpi-front{ opacity:0; transform:translateY(-8px); pointer-events:none; }
			  .kpi-wrap:hover .kpi-back{ opacity:1; transform:translateY(0); pointer-events:auto; }
			  .kpi-label{ font-size:10.5px; font-weight:700; letter-spacing:1.3px; color:#f0a99e; text-transform:uppercase; }
			  .kpi-value{ font-family:Cormorant Garamond,Georgia,serif; font-size:32px; font-weight:700; color:#fff; margin-top:6px; text-shadow:0 2px 6px rgba(0,0,0,.4); }
			  .kpi-sub{ font-size:11px; color:#c9beb5; margin-top:4px; }
			  .kpi-hint{ font-size:9.5px; color:#a79a92; margin-top:8px; opacity:.8; }
			  .kpi-back-title{ font-size:10px; font-weight:700; letter-spacing:1.2px; color:#f0a99e; text-transform:uppercase; }
			  .kpi-back-val{ font-family:Cormorant Garamond,Georgia,serif; font-size:24px; font-weight:700; color:#f0a99e; margin-top:6px; }
			  .kpi-back-txt{ font-size:11px; color:#d8ccc3; line-height:1.4; margin-top:4px; }
			</style>
			<div class='kpi-wrap'>
			  <div class='kpi-face kpi-front'>
			    <div class='kpi-label'>Avg Annual Income</div>
			    <div class='kpi-value'>" & _avgTxt & "</div>
			    <div class='kpi-sub'>Across current borrower selection</div>
			    <div class='kpi-hint'>Hover for income gap by grade</div>
			  </div>
			  <div class='kpi-face kpi-back'>
			    <div class='kpi-back-title'>Income gap, Grade " & _bestGrade & " vs " & _worstGrade & "</div>
			    <div class='kpi-back-val'>" & _gapTxt & "</div>
			    <div class='kpi-back-txt'>Grade " & _bestGrade & " borrowers earn this much more on average than Grade " & _worstGrade & " borrowers.</div>
			  </div>
			</div>
			</div>"
			RETURN _html
		displayFolder: HTML Visuals
		lineageTag: 1f574fc7-b9d0-497e-ad2a-1c478f9c1a67

	/// KPI hover card: Avg FICO Score (front) / reported FICO band width (hover reveal).
	measure 'KPI FICO HTML' =
			VAR _fico = [Avg FICO Score]
			VAR _ficoTxt = FORMAT(_fico, "0")
			VAR _low = AVERAGE(fact_loan[fico_range_low])
			VAR _high = AVERAGE(fact_loan[fico_range_high])
			VAR _bandTxt = FORMAT(_low, "0") & "–" & FORMAT(_high, "0")
			VAR _html =
			"<div style='font-family:Jost,Segoe UI,system-ui,sans-serif;position:relative;overflow:hidden;height:100vh;width:100%;border-radius:10px;cursor:pointer;'>
			<style>
			  html,body{ overflow:hidden!important; margin:0; padding:0; height:100vh; width:100%; background:transparent!important }
			  .kpi-wrap{ position:relative; width:100%; height:100%; overflow:hidden; border-radius:10px; background:linear-gradient(155deg,#241411,#1e130f); }
			  .kpi-face{ position:absolute; inset:0; padding:16px 18px; display:flex; flex-direction:column; justify-content:center; box-sizing:border-box; transition:opacity .35s ease, transform .35s ease; }
			  .kpi-front{ opacity:1; transform:translateY(0); }
			  .kpi-back{ opacity:0; transform:translateY(8px); pointer-events:none; }
			  .kpi-wrap:hover .kpi-front{ opacity:0; transform:translateY(-8px); pointer-events:none; }
			  .kpi-wrap:hover .kpi-back{ opacity:1; transform:translateY(0); pointer-events:auto; }
			  .kpi-label{ font-size:10.5px; font-weight:700; letter-spacing:1.3px; color:#f0a99e; text-transform:uppercase; }
			  .kpi-value{ font-family:Cormorant Garamond,Georgia,serif; font-size:32px; font-weight:700; color:#fff; margin-top:6px; text-shadow:0 2px 6px rgba(0,0,0,.4); }
			  .kpi-sub{ font-size:11px; color:#c9beb5; margin-top:4px; }
			  .kpi-hint{ font-size:9.5px; color:#a79a92; margin-top:8px; opacity:.8; }
			  .kpi-back-title{ font-size:10px; font-weight:700; letter-spacing:1.2px; color:#f0a99e; text-transform:uppercase; }
			  .kpi-back-val{ font-family:Cormorant Garamond,Georgia,serif; font-size:24px; font-weight:700; color:#f0a99e; margin-top:6px; }
			  .kpi-back-txt{ font-size:11px; color:#d8ccc3; line-height:1.4; margin-top:4px; }
			</style>
			<div class='kpi-wrap'>
			  <div class='kpi-face kpi-front'>
			    <div class='kpi-label'>Avg FICO Score</div>
			    <div class='kpi-value'>" & _ficoTxt & "</div>
			    <div class='kpi-sub'>Average borrower credit score</div>
			    <div class='kpi-hint'>Hover for reported score band</div>
			  </div>
			  <div class='kpi-face kpi-back'>
			    <div class='kpi-back-title'>Reported score band</div>
			    <div class='kpi-back-val'>" & _bandTxt & "</div>
			    <div class='kpi-back-txt'>Typical low–high FICO range reported across borrowers, before it&#39;s rounded to one score.</div>
			  </div>
			</div>
			</div>"
			RETURN _html
		displayFolder: HTML Visuals
		lineageTag: 2865d2bc-c1d4-432e-8cc1-4b6f13353cba

	/// KPI hover card: Avg DTI (front) / share of borrowers above a 36% high-DTI threshold (hover reveal). Verify win_dti is on a 0-100 scale, not 0-1, before trusting the 36 threshold.
	measure 'KPI DTI HTML' =
			VAR _dti = [AVG DTI]
			VAR _dtiTxt = FORMAT(_dti, "0.0") & "%"
			VAR _highShare = DIVIDE(CALCULATE(COUNTROWS(fact_loan), fact_loan[win_dti] > 36), COUNTROWS(fact_loan))
			VAR _highShareTxt = FORMAT(_highShare, "0.0%")
			VAR _html =
			"<div style='font-family:Jost,Segoe UI,system-ui,sans-serif;position:relative;overflow:hidden;height:100vh;width:100%;border-radius:10px;cursor:pointer;'>
			<style>
			  html,body{ overflow:hidden!important; margin:0; padding:0; height:100vh; width:100%; background:transparent!important }
			  .kpi-wrap{ position:relative; width:100%; height:100%; overflow:hidden; border-radius:10px; background:linear-gradient(155deg,#241411,#1e130f); }
			  .kpi-face{ position:absolute; inset:0; padding:16px 18px; display:flex; flex-direction:column; justify-content:center; box-sizing:border-box; transition:opacity .35s ease, transform .35s ease; }
			  .kpi-front{ opacity:1; transform:translateY(0); }
			  .kpi-back{ opacity:0; transform:translateY(8px); pointer-events:none; }
			  .kpi-wrap:hover .kpi-front{ opacity:0; transform:translateY(-8px); pointer-events:none; }
			  .kpi-wrap:hover .kpi-back{ opacity:1; transform:translateY(0); pointer-events:auto; }
			  .kpi-label{ font-size:10.5px; font-weight:700; letter-spacing:1.3px; color:#f0a99e; text-transform:uppercase; }
			  .kpi-value{ font-family:Cormorant Garamond,Georgia,serif; font-size:32px; font-weight:700; color:#fff; margin-top:6px; text-shadow:0 2px 6px rgba(0,0,0,.4); }
			  .kpi-sub{ font-size:11px; color:#c9beb5; margin-top:4px; }
			  .kpi-hint{ font-size:9.5px; color:#a79a92; margin-top:8px; opacity:.8; }
			  .kpi-back-title{ font-size:10px; font-weight:700; letter-spacing:1.2px; color:#f0a99e; text-transform:uppercase; }
			  .kpi-back-val{ font-family:Cormorant Garamond,Georgia,serif; font-size:24px; font-weight:700; color:#f0a99e; margin-top:6px; }
			  .kpi-back-txt{ font-size:11px; color:#d8ccc3; line-height:1.4; margin-top:4px; }
			</style>
			<div class='kpi-wrap'>
			  <div class='kpi-face kpi-front'>
			    <div class='kpi-label'>Avg DTI</div>
			    <div class='kpi-value'>" & _dtiTxt & "</div>
			    <div class='kpi-sub'>Average debt-to-income ratio</div>
			    <div class='kpi-hint'>Hover for high-DTI share</div>
			  </div>
			  <div class='kpi-face kpi-back'>
			    <div class='kpi-back-title'>High-DTI share</div>
			    <div class='kpi-back-val'>" & _highShareTxt & "</div>
			    <div class='kpi-back-txt'>Share of borrowers carrying a debt-to-income ratio above 36% — a common affordability-risk line.</div>
			  </div>
			</div>
			</div>"
			RETURN _html
		displayFolder: HTML Visuals
		lineageTag: 3e233791-d2dc-40bc-bceb-1267cce1dda4

	/// Content for the State Details tooltip page shown on hover over the USA Shape Map (Borrower Profile page). Dark teal card: state name, risk badge (default rate vs portfolio average), then a 2x3 grid — Total Amount, Total Loans, Avg Income, Avg FICO, Avg DTI, Avg Interest Rate. Designed for a ~320x240 tooltip canvas.
	measure 'State Tooltip HTML' =
			VAR _state = SELECTEDVALUE(dim_geography[State Full Name], "Select a state")
			VAR _amt = [Total Amount]
			VAR _amtTxt = IF(_amt>=1000000000, FORMAT(_amt/1000000000,"0.00") & "B", IF(_amt>=1000000, FORMAT(_amt/1000000,"0.0") & "M", "$" & FORMAT(_amt,"#,##0")))
			VAR _cntTxt = FORMAT([Total Loan],"#,##0")
			VAR _incTxt = "$" & FORMAT([AVG Annual Income],"#,##0")
			VAR _ficoTxt = FORMAT([Avg FICO Score],"0")
			VAR _dtiTxt = FORMAT([AVG DTI],"0.0") & "%"
			VAR _rateTxt = FORMAT([AVG Interest Rate],"0.0") & "%"
			VAR _def = [AVG Default Rate]
			VAR _defTxt = FORMAT(_def,"0.0%")
			VAR _overallDef = CALCULATE([AVG Default Rate], ALL(dim_geography))
			VAR _defColor = IF(_def > _overallDef * 1.1, "#E8604C", IF(_def < _overallDef * 0.9, "#4FD69C", "#E0B35C"))
			VAR _defLabel = IF(_def > _overallDef * 1.1, "Above-average risk", IF(_def < _overallDef * 0.9, "Below-average risk", "Near-average risk"))
			VAR _css = "<style>html,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden;background:#0d1b19!important}*{box-sizing:border-box}.tp{font-family:Jost,'Segoe UI',sans-serif;width:100%;height:100%;background:linear-gradient(155deg,#132623,#0d1b19);padding:16px 18px;color:#fff;display:flex;flex-direction:column}.hd{display:flex;align-items:flex-start;justify-content:space-between}.st{font-family:'Cormorant Garamond',Georgia,serif;font-size:21px;font-weight:700;color:#fff;line-height:1.1}.sub{font-size:9.5px;letter-spacing:1px;text-transform:uppercase;color:#7fb8ae;margin-top:3px}.badge{font-size:9px;font-weight:700;letter-spacing:.3px;padding:4px 9px;border-radius:20px;white-space:nowrap}.grid{margin-top:14px;display:grid;grid-template-columns:1fr 1fr 1fr;row-gap:12px}.cell{display:flex;flex-direction:column}.k{font-size:8.5px;letter-spacing:.6px;text-transform:uppercase;color:#7fb8ae}.v{font-size:15px;font-weight:700;color:#fff;margin-top:2px}</style>"
			RETURN _css & "<div class='tp'><div class='hd'><div><div class='st'>" & _state & "</div><div class='sub'>Borrower snapshot</div></div><div class='badge' style='background:" & _defColor & "22;color:" & _defColor & ";border:1px solid " & _defColor & "55'>" & _defTxt & " · " & _defLabel & "</div></div><div class='grid'><div class='cell'><div class='k'>Total Amount</div><div class='v'>" & _amtTxt & "</div></div><div class='cell'><div class='k'>Total Loans</div><div class='v'>" & _cntTxt & "</div></div><div class='cell'><div class='k'>Avg Interest</div><div class='v'>" & _rateTxt & "</div></div><div class='cell'><div class='k'>Avg Income</div><div class='v'>" & _incTxt & "</div></div><div class='cell'><div class='k'>Avg FICO</div><div class='v'>" & _ficoTxt & "</div></div><div class='cell'><div class='k'>Avg DTI</div><div class='v'>" & _dtiTxt & "</div></div></div></div>"
		displayFolder: HTML Visuals
		lineageTag: f2881427-c47d-4ae9-a9ed-61936e13556e

	measure 'Borrower Emp exp HTML' = ```
			
			 <!DOCTYPE html>
			<html lang="en">
			<head>
			<meta charset="UTF-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>Employment Length vs Default Rate</title>
			<script src="https://cdnjs.cloudflare.com/ajax/libs/matter-js/0.19.0/matter.min.js"></script>
			<style>
			  :root{
			    --fg:#111111;
			    --fg-dim:#6b6b6b;
			  }
			  *{box-sizing:border-box;}
			  body{
			    margin:0;
			    background:#ffffff;
			    color:var(--fg);
			    font-family:'Segoe UI', system-ui, sans-serif;
			    display:flex;
			    flex-direction:column;
			    align-items:center;
			    padding:24px 12px 40px;
			  }
			  h1{
			    font-size:1.15rem;
			    font-weight:600;
			    letter-spacing:.2px;
			    margin:0 0 2px;
			  }
			  p.sub{
			    margin:0 0 18px;
			    color:var(--fg-dim);
			    font-size:.85rem;
			  }
			  #stage-wrap{
			    position:relative;
			    width:100%;
			    max-width:900px;
			    background:#ffffff;
			    border-radius:10px;
			    overflow:hidden;
			    border:1px solid #e5e5e5;
			  }
			  canvas{display:block;width:100%;}
			  #legend{
			    display:flex;
			    justify-content:space-between;
			    max-width:900px;
			    width:100%;
			    margin-top:10px;
			    font-size:.72rem;
			    color:var(--fg-dim);
			  }
			  #legend .bar{
			    height:6px;
			    flex:1;
			    margin:0 10px;
			    border-radius:3px;
			    background:linear-gradient(90deg,#d9d9d9,#111111);
			    align-self:center;
			  }
			  #replay{
			    margin-top:18px;
			    background:#ffffff;
			    border:1px solid #cccccc;
			    color:var(--fg);
			    padding:8px 16px;
			    border-radius:6px;
			    cursor:pointer;
			    font-size:.82rem;
			  }
			  #replay:hover{background:#f2f2f2;}
			</style>
			</head>
			<body>
			
			<h1>Employment length vs default rate</h1>
			<p class="sub">Each circle is an employment-length group &mdash; size alone tracks the average default rate.</p>
			
			<div id="stage-wrap">
			  <canvas id="stage"></canvas>
			</div>
			
			<div id="legend">
			  <span>Lower default rate</span>
			  <div class="bar"></div>
			  <span>Higher default rate</span>
			</div>
			
			<button id="replay">Replay</button>
			
			<script>
			const data = [
			  { label: "Unknown",   rate: 0.1438 },
			  { label: "8 years",   rate: 0.1316 },
			  { label: "9 years",   rate: 0.1277 },
			  { label: "7 years",   rate: 0.1254 },
			  { label: "1 year",    rate: 0.1226 },
			  { label: "3 years",   rate: 0.1189 },
			  { label: "2 years",   rate: 0.1184 },
			  { label: "6 years",   rate: 0.1183 },
			  { label: "5 years",   rate: 0.1181 },
			  { label: "< 1 year",  rate: 0.1168 },
			  { label: "4 years",   rate: 0.1164 },
			  { label: "10+ years", rate: 0.1110 }
			];
			
			const { Engine, Render, Runner, World, Bodies, Body, Events } = Matter;
			
			const canvas = document.getElementById('stage');
			
			const W = 900, H = 520;
			canvas.width = W;
			canvas.height = H;
			
			const engine = Engine.create();
			engine.gravity.y = 1.1;
			
			const render = Render.create({
			  canvas,
			  engine,
			  options: {
			    width: W,
			    height: H,
			    wireframes: false,
			    background: '#ffffff'
			  }
			});
			Render.run(render);
			const runner = Runner.create();
			Runner.run(runner, engine);
			
			const minR = 32, maxR = 70;
			const rates = data.map(d => d.rate);
			const rMin = Math.min(...rates), rMax = Math.max(...rates);
			function radiusFor(rate){
			  const t = (rate - rMin) / (rMax - rMin);
			  return minR + t * (maxR - minR);
			}
			// pure black ring for every circle; size alone carries the value
			function ringColorFor(rate){
			  return '#111111';
			}
			
			const floor = Bodies.rectangle(W/2, H+20, W+40, 40, { isStatic:true, render:{visible:false} });
			const wallL = Bodies.rectangle(-20, H/2, 40, H*2, { isStatic:true, render:{visible:false} });
			const wallR = Bodies.rectangle(W+20, H/2, 40, H*2, { isStatic:true, render:{visible:false} });
			World.add(engine.world, [floor, wallL, wallR]);
			
			let circles = [];
			
			function spawnAll(){
			  circles.forEach(c => World.remove(engine.world, c.body));
			  circles = [];
			
			  // sort so biggest (highest rate) falls first -> ends up more central/bottom
			  const ordered = [...data].sort((a,b) => b.rate - a.rate);
			
			  ordered.forEach((d, i) => {
			    const r = radiusFor(d.rate);
			    // all start near the same narrow point at top-center, small random jitter
			    const x = W/2 + (Math.random()*30 - 15);
			    const y = -80 - i * 90; // staggered so they don't all spawn overlapping at once
			    const body = Bodies.circle(x, y, r, {
			      restitution: 0.35,
			      friction: 0.5,
			      frictionAir: 0.01,
			      render: {
			        fillStyle: '#ffffff',
			        strokeStyle: ringColorFor(d.rate),
			        lineWidth: 6
			      }
			    });
			    Body.setAngle(body, (Math.random()-0.5) * 0.4);
			    World.add(engine.world, body);
			    circles.push({ body, label: d.label, rate: d.rate, r });
			  });
			}
			
			spawnAll();
			
			Events.on(render, 'afterRender', () => {
			  const ctx = render.context;
			  circles.forEach(c => {
			    const { x, y } = c.body.position;
			    ctx.save();
			    ctx.translate(x, y);
			    ctx.textAlign = 'center';
			    ctx.fillStyle = '#111111';
			    const labelSize = Math.max(10, c.r * 0.26);
			    const pctSize = Math.max(11, c.r * 0.30);
			    ctx.font = `600 ${labelSize}px Segoe UI, sans-serif`;
			    ctx.fillText(c.label, 0, -4);
			    ctx.font = `700 ${pctSize}px Segoe UI, sans-serif`;
			    ctx.fillText((c.rate*100).toFixed(1) + '%', 0, 16);
			    ctx.restore();
			  });
			});
			
			document.getElementById('replay').addEventListener('click', spawnAll);
			</script>
			
			</body>
			</html>
			
			```
		displayFolder: HTML Visuals
		lineageTag: ef804ad6-b6bb-494c-a28d-8e637e0dd478

	/// Page title block for the Risk Analysis page with charcoal styling and risk-focused subtitle.
	measure 'Risk Page Title HTML' =
			VAR _y1 = MIN(dim_date[year])
			VAR _y2 = MAX(dim_date[year])
			VAR _period = IF(_y1 = _y2, FORMAT(_y1,"0"), FORMAT(_y1,"0") & " &ndash; " & FORMAT(_y2,"0"))
			VAR _html =
			"<div style='font-family:Jost,Segoe UI,system-ui,sans-serif;height:100vh;width:100%;box-sizing:border-box;'>
			<style>
			  html,body{ overflow:hidden!important; margin:0; padding:0; height:100vh; width:100%; background:transparent!important }
			  .wrap{ height:100%; width:100%; display:flex; flex-direction:column; justify-content:space-between; box-sizing:border-box; padding:2px 0 0 0 }
			  .top{ display:flex; align-items:flex-end; justify-content:space-between; gap:16px }
			  .ttl{ font-family:Cormorant Garamond,Georgia,serif; font-size:38px; font-weight:600; color:#2d2c2c; line-height:1.02; letter-spacing:-.2px }
			  .sub{ font-size:14px; font-weight:400; color:#666565; margin-top:6px; letter-spacing:.4px }
			  .per{ font-size:12px; font-weight:500; letter-spacing:1.6px; color:#666565; padding-bottom:3px; white-space:nowrap }
			  .per b{ color:#464444; font-weight:600 }
			  .rule{ height:3px; width:100%; border-radius:999px; background:linear-gradient(90deg,#464444 0%,#9b9999 55%,rgba(155,153,153,0) 100%); margin-bottom:2px }
			</style>
			<div class='wrap'>
			  <div class='top'>
			    <div>
			      <div class='ttl'>Risk Analysis</div>
			      <div class='sub'>Default Rate &middot; Exposure &middot; Grade &middot; Vintage</div>
			    </div>
			    <div class='per'>PERIOD &nbsp;<b>" & _period & "</b></div>
			  </div>
			  <div class='rule'></div>
			</div>
			</div>"
			RETURN _html
		displayFolder: HTML Visuals
		lineageTag: 85505155-0cb5-4b2c-90c2-41a9bc67601c

