table dim_geography
	lineageTag: 890c063e-28d3-4675-9eb3-b7988c2aedc7

	column state_key
		dataType: int64
		isHidden
		isNullable: false
		formatString: 0
		sourceProviderType: int
		lineageTag: 88af0a17-d523-4ada-989f-1878562fd86b
		summarizeBy: none
		sourceColumn: state_key

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column borrower_state
		dataType: string
		isNullable: false
		sourceProviderType: varchar(5)
		lineageTag: e87ed3d4-b5ba-4a70-85c2-616ca2ec10fd
		summarizeBy: none
		sourceColumn: borrower_state

		annotation SummarizationSetBy = Automatic

	/// Full US state/territory name derived from the 2-letter borrower_state code, for use in Map/Filled Map visuals (Bing geocoding needs a full name, not an abbreviation). Falls back to the original code for anything unmapped.
	column 'State Full Name' =
			SWITCH(
			    dim_geography[borrower_state],
			    "AL","Alabama","AK","Alaska","AZ","Arizona","AR","Arkansas","CA","California",
			    "CO","Colorado","CT","Connecticut","DE","Delaware","DC","District of Columbia",
			    "FL","Florida","GA","Georgia","HI","Hawaii","ID","Idaho","IL","Illinois",
			    "IN","Indiana","IA","Iowa","KS","Kansas","KY","Kentucky","LA","Louisiana",
			    "ME","Maine","MD","Maryland","MA","Massachusetts","MI","Michigan","MN","Minnesota",
			    "MS","Mississippi","MO","Missouri","MT","Montana","NE","Nebraska","NV","Nevada",
			    "NH","New Hampshire","NJ","New Jersey","NM","New Mexico","NY","New York","NC","North Carolina",
			    "ND","North Dakota","OH","Ohio","OK","Oklahoma","OR","Oregon","PA","Pennsylvania",
			    "RI","Rhode Island","SC","South Carolina","SD","South Dakota","TN","Tennessee","TX","Texas",
			    "UT","Utah","VT","Vermont","VA","Virginia","WA","Washington","WV","West Virginia",
			    "WI","Wisconsin","WY","Wyoming",
			    "PR","Puerto Rico","VI","U.S. Virgin Islands","GU","Guam","AS","American Samoa","MP","Northern Mariana Islands",
			    "AE","Armed Forces Europe","AA","Armed Forces Americas","AP","Armed Forces Pacific",
			    dim_geography[borrower_state]
			)
		dataType: string
		displayFolder: Geography
		lineageTag: 241a009a-09c5-42e3-86f5-c0c0056c96c7
		dataCategory: StateOrProvince
		summarizeBy: none

	/// State Full Name plus ', United States' suffix, purpose-built for the Map/Filled Map Location field so Bing's geocoder doesn't mismatch a bare state name against a same-named place elsewhere in the world. Use this instead of State Full Name if bubbles land in the wrong place or don't resolve.
	column 'State Full Name (Geocode)' = dim_geography[State Full Name] & ", United States"
		dataType: string
		displayFolder: Geography
		lineageTag: 3200dbef-c0e3-48ba-ba5a-f267bcbafb4a
		dataCategory: Place
		summarizeBy: none

	partition dim_geography = m
		mode: directQuery
		source =
				let
				  Source = Sql.Database("LAPTOP-2M8AORNT\SQLEXPRESS", "LendingClubDB"),
				  #"Navigation 1" = Source{[Schema = "dbo", Item = "dim_geography"]}[Data]
				in
				  #"Navigation 1"

	annotation PBI_ResultType = Table

