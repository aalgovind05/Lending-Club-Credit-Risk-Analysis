			    <foreignObject class='info info-def' x='250' y='45' width='215' height='140'><div xmlns='http://www.w3.org/1999/xhtml' class='info-card' style='background:linear-gradient(135deg,#7A211B,#4d1512)'><div class='info-top'><div class='info-icon'><svg viewBox='0 0 24 24' fill='none' stroke='#fff' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polygon points='7.5,2 16.5,2 22,7.5 22,16.5 16.5,22 7.5,22 2,16.5 2,7.5'></polygon><line x1='12' y1='8' x2='12' y2='13'></line><circle cx='12' cy='16' r='0.7' fill='#fff'></circle></svg></div><div class='info-title'>Default</div></div><div class='info-count'>" & _defF & "</div><div class='info-desc'>Formally defaulted &mdash; the most severe non-payment outcome.</div></div></foreignObject>
			
