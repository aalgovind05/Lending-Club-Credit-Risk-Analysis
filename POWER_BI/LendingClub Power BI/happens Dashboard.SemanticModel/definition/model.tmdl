model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_borrower","dim_date","dim_geography","dim_grade","dim_loan_status","dim_purpose","fact_loan"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table dim_borrower
ref table dim_date
ref table dim_geography
ref table dim_grade
ref table dim_loan_status
ref table dim_purpose
ref table fact_loan
ref table _Measures

ref cultureInfo en-US

